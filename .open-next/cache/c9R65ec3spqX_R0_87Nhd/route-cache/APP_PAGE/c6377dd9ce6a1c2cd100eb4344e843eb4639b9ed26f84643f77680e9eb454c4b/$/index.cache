]\\\",\\\"children\\\":\\\"What does your daily chaos look like?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-6 max-w-xl leading-[1.8] text-muted\\\",\\\"children\\\":\\\"Three field reports from real businesses. If you recognize your own operation in any of them, the cure already exists.\\\"}]]}]}],[[\\\"$\\\",\\\"article\\\",\\\"01\\\",{\\\"className\\\":\\\"border-b border-ink/10\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid md:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center justify-center px-6 py-16 md:px-16 md:py-24 \\\",\\\"children\\\":[\\\"$\\\",\\\"$L1d\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"figure\\\",null,{\\\"className\\\":\\\"relative\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute -inset-4 bg-green/[0.06] blur-2xl\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\\\",\\\"alt\\\":\\\"Manga panel of a frayed network cable bundle in a server rack\\\",\\\"loading\\\":\\\"lazy\\\",\\\"decoding\\\":\\\"async\\\",\\\"className\\\":\\\"relative w-64 border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)] md:w-80\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"mt-5 flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Fig. 01 — The frayed cable bundle.\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-outline font-serif text-2xl italic\\\",\\\"children\\\":\\\"01\\\"}]]}]]}]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col justify-center px-6 py-14 md:px-16 md:py-24 \\\",\\\"children\\\":[\\\"$\\\",\\\"$L1d\\\",null,{\\\"delay\\\":120,\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mb-4 font-mono text-[10p