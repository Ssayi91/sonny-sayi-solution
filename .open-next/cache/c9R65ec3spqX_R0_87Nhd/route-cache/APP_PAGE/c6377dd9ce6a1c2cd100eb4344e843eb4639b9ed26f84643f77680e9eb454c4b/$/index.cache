er border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)] md:w-80\"}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Fig. 02 — Friday-night reconciliation.\"}],[\"$\",\"span\",null,{\"className\":\"text-outline font-serif text-2xl italic\",\"children\":\"02\"}]]}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-center px-6 py-14 md:px-16 md:py-24 md:order-1\",\"children\":[\"$\",\"$L1d\",null,{\"delay\":120,\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-4 font-mono text-[10px] uppercase tracking-[0.3em] text-green\",\"children\":\"Custom Applications\"}],[\"$\",\"h3\",null,{\"className\":\"mb-8 font-serif font-semibold leading-tight text-3xl md:text-4xl\",\"children\":\"The Spreadsheet That Runs the Business\"}],[\"$\",\"p\",null,{\"className\":\"mb-10 max-w-md leading-[1.9] text-muted\",\"children\":\"Orders arrive on WhatsApp. Receipts are sent as screenshots. Someone copies the numbers into Excel. Someone else checks them against a notebook. At the end of the week, the team spends hours finding what was missed, what was paid and what still needs to be followed up. The business is moving, but the people inside it are spending their time moving information from one place to another.\"}],[\"$\",\"div\",null,{\"className\":\"mb-10 border-l-2 border-green pl-6\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2 font-mono text-[10px] uppercase tracking-[0.3em] text-muted\",\"children\":\"The Cure\"}],[\"$\",\"p\",null,{\"className\":\"max-w-md leading-[1.8]\",\"children\":\"We turn the manual process into a system. Orders, customers, receipts, approvals, stock, commissions and reports live in one place. The system handles the repetitive work so your team can spend its time running the business instead of reconciling it.\"}]]}],[\"$\",\"a\",null,{\"href\":\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20spreadsheet%20story.%20We%20still%20run%20too%20much%20of%20our%20business%20manually.%20Let's%20talk.\",\"target\":\"_blank\",\"className\":\"group flex w-fit items-center gap-2 border-b border-ink/30 pb-1 text-sm uppercase tracking-widest transition-colors hover:border-green hover:text-green\",\"children\":[\"Is this your problem? \",[\"$\",\"svg\",null,{\"width\":\"11\",\"height\":\"11\",\"viewBox\":\"0 0 12 12\",\"fill\":\"none\",\"className\":\"transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2 10L10 2M10 2H4M10 2V8\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.2\"}]}]]}]]}]}]]}]\n1f:[\"$\",\"article\",\"03\",{\"className\":\"border-b border-ink/10\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-center px-6 py-16 md:px-16 md:py-24 \",\"children\":[\"$\",\"$L1d\",null,{\"children\":[\"$\",\"figure\",null,{\"className\":\"relative\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -inset-4 bg-green/[0.06] blur-2xl\",\"aria-hidden\":\"true\"}],[\"$\",\"img\",null,{\"src\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859644/surgical-showroom_d0gdmo.png\",\"alt\":\"Manga panel of a medical supplies website presented as a digital showroom\",\"loading\":\"lazy\",\"decoding\":\"async\",\"className\":\"relative w-64 border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)] md:w-80\"}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Fig. 03 — The surgical showroom.\"}],[\"$\",\"span\",null,{\"className\":\"text-outline font-serif text-2xl italic\",\"children\":\"03\"}]]}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-center px-6 py-14 md:px-16 md:py-24 \",