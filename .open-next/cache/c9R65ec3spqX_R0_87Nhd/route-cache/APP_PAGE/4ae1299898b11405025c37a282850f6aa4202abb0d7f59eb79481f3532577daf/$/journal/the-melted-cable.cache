c=\"/_next/static/chunks/1_q4oc079m3pu.js\" async=\"\"></script><title>The Network That Worked Until It Didn&#x27;t | Sonny Sayi Solutions</title><meta name=\"description\" content=\"Indoor cable exposed to the sun. Unmanaged switches. No patch panels. No documentation. A school network built to get by, not to support hundreds of students.\"/><meta property=\"og:title\" content=\"The Network That Worked Until It Didn&#x27;t\"/><meta property=\"og:description\" content=\"Indoor cable exposed to the sun. Unmanaged switches. No patch panels. No documentation. A school network built to get by, not to support hundreds of students.\"/><meta property=\"og:image\" content=\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"The Network That Worked Until It Didn&#x27;t\"/><meta name=\"twitter:description\" content=\"Indoor cable exposed to the sun. Unmanaged switches. No patch panels. No documentation. A school network built to get by, not to support hundreds of students.\"/><meta name=\"twitter:image\" content=\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent\"><div class=\"flex items-center justify-between px-6 py-5 md:px-16\"><a class=\"flex items-center gap-4\" href=\"/\"><img alt=\"Sonny Sayi Solutions\" loading=\"lazy\" width=\"40\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=https%3A%2F%2Fres.cloudinary.com%2Fdzyxm0rhg%2Fimage%2F