"the-melted-cable\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"t\\\":{\\\"t\\\":{\\\"s\\\":\\\"\\\",\\\"h\\\":528,\\\"d\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/1pw566iu1r5qg.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/3qfy96eoyh-ek.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-1\\\",{\\\"src\\\":\\\"/_next/static/chunks/1_q4oc079m3pu.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"className\\\":\\\"scroll-smooth\\\",\\\"children\\\":[\\\"$\\\",\\\"body\\\",null,{\\\"className\\\":\\\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L4\\\",null,{}],[\\\"$\\\",\\\"$L5\\\",null,{}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L7\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":[[[\\\"$\\\",\\\"title\\\",null,{\\\"children\\\":\\\"404: This page could not be found.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"fontFamily\\\":\\\"system-ui,\\\\\\\"Segoe UI\\\\\\\",Roboto,Helvetica,Arial,sans-serif,\\\\\\\"Apple Color Emoji\\\\\\\",\\\\\\\"Segoe UI Emoji\\\\\\\"\\\",\\\"height\\\":\\\"100vh\\\",\\\"textAlign\\\":\\\"center\\\",\\\"display\\\":\\\"flex\\\",\\\"flexDirection\\\":\\\"column\\\",\\\"alignItems\\\":\\\"center\\\",\\\"justifyContent\\\":\\\"center\\\"},\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\\\"}}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"next-error-h1\\\",\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\",\\\"margin\\\":\\\"0 20px 0 0\\\",\\\"padding\\\":\\\"0 23px 0 0\\\",\\\"fontSize\\\":24,\\\"fontWeight\\\":500,\\\"verticalAlign\\\":\\\"top\\\",\\\"lineHeight\\\":\\\"49px\\\"},\\\"children\\\":404}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\"},\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"fontSize\\\":14,\\\"fontWeight\\\":400,\\\"lineHeight\\\":\\\"49px\\\",\\\"margin\\\":0},\\\"children\\\":\\\"This page could not be found.\\\"}]}]]}]}]],[]],\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}]}]]}],\\\"p\\\":false,\\\"v\\\":null},\\\"c\\\":\\\"$Q8\\\"},\\\"h\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L11\\\",null,{\\\"children\\\":\\\"$L12\\\"}],[\\\"$\\\",\\\"$L14\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$e\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L15\\\"}]}],null]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],\\\"p\\\":false,\\\"v\\\":null}},\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$16\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/1pw566iu1r5qg.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"r\\\":\\\"$undefined\\\",\\\"s\\\":\\\"$undefined\\\",\\\"a\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"c9R65ec3spqX_R0_87Nhd\\\"}\\n:HL[\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\\\",\\\"image\\\"]\\n9:C\\n17:Tc5f,\\u003cp\\u003eThe call came during a school day.\\u003c/p\\u003e\\n\\u003cp\\u003eStudents were trying to access online resources. Several computers had already lost connectivity. Staff couldn't tell where the fault was, only that parts of the network kept disappearing.\\u003c/p\\u003e\\n\\u003cp\\u003eThe network had not failed overnight.\\u003c/p\\u003e\\n\\u003cp\\u003eIt had been failing slowly for years.\\u003c/p\\u003e\\n\\u003ch2\\u003eWhat we found\\u003c/h2\\u003e\\n\\u003cp\\u003eWalking through the campus, the first issue was visible before opening a single cabinet.\\u003c/p\\u003e\\n\\u003cp\\u003eA section of the network linking school buildings had been installed using \\u003cstrong\\u003eindoor Ethernet cable on an outdoor run\\u003c/strong\\u003e. Years of sun exposure had hardened and damaged the cable jacket. The link was no longer reliable.\\u003c/p\\u003e\\n\\u003cp\\u003eInside the buildings, the story continued.\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003eNo patch panels.\\u003c/li\\u003e\\n\\u003cli\\u003eNo structured cable management.\\u003c/li\\u003e\\n\\u003cli\\u003eNo proper trunking in several runs.\\u003c/li\\u003e\\n\\u003cli\\u003eMultiple unmanaged switches distributed across the network.\\u003c/li\\u003e\\n\\u003cli\\u003eLittle visibility into where cables started or ended.\\u003c/li\\u003e\\n\\u003cli\\u003eSeveral computers disconnected or improperly terminated.\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003eNothing looked catastrophic in isolation.\\u003c/p\\u003e\\n\\u003cp\\u003eTogether, however, every future fault became harder to find, harder to diagnose and more disruptive to learning.\\u003c/p\\u003e\\n\\u003ch2\\u003eThe real problem\\u003c/h2\\u003e\\n\\u003cp\\u003eThe damaged outdoor cable was only the symptom.\\u003c/p\\u003e\\n\\u003cp\\u003eThe larger issue was that the network had grown without structure.\\u003c/p\\u003e\\n\\u003cp\\u003eNew devices had been added whenever they were needed. Additional cables had been pulled whenever someone needed another connection. Small decisions accumulated over time until nobody had a clear view of the entire network.\\u003c/p\\u003e\\n\\u003cp\\u003eWhen something stopped working, troubleshooting became a process of elimination rather than a process of management.\\u003c/p\\u003e\\n\\u003ch2\\u003eWhy this matters\\u003c/h2\\u003e\\n\\u003cp\\u003eSchools depend on connectivity far more than they did a decade ago.\\u003c/p\\u003e\\n\\u003cp\\u003eStudent portals, administration systems, online learning resources, examinations, printers and communication platforms all rely on the same infrastructure.\\u003c/p\\u003e\\n\\u003cp\\u003eWhen the network becomes unreliable, teaching time is lost, administrative work slows down and students feel the impact immediately.\\u003c/p\\u003e\\n\\u003ch2\\u003eThe work\\u003c/h2\\u003e\\n\\u003cp\\u003eThe damaged runs were identified and replaced with proper outdoor-rated cable where required.\\u003c/p\\u003e\\n\\u003cp\\u003eExisting cable routes were reorganised and properly terminated.\\u003c/p\\u003e\\n\\u003cp\\u003eNetwork points that had lost connectivity were tested and restored.\\u003c/p\\u003e\\n\\u003cp\\u003eComputers that could not access the network were traced, diagnosed and brought back online.\\u003c/p\\u003e\\n\\u003cp\\u003eThe goal was not to add complexity.\\u003c/p\\u003e\\n\\u003cp\\u003eThe goal was to restore reliability and create a network that staff could depend on every day.\\u003c/p\\u003e\\n\\u003ch2\\u003eThe lesson\\u003c/h2\\u003e\\n\\u003cp\\u003eMost network failures are not caused by a single dramatic event.\\u003c/p\\u003e\\n\\u003cp\\u003eThey come from years of shortcuts.\\u003c/p\\u003e\\n\\u003cp\\u003eThe wrong cable in the wrong environment.\\nThe missing labels.\\nThe unmanaged growth.\\nThe assumption that if it works today, it will work tomorrow.\\u003c/p\\u003e\\n\\u003cp\\u003eEventually those shortcuts become the outage.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003eIf your organisation relies on a network that nobody fully understands, the problem is rarely the latest fault.\\u003c/p\\u003e\\n\\u003cp\\u003eThe problem is usually the system underneath it.\\u003c/p\\u003e\\nc:[\\\"$\\\",\\\"main\\\",null,{\\\"className\\\":\\\"pt-28 md:pt-32\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"px-6 py-16 md:px-16 md:py-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-3xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-green\\\",\\\"children\\\":\\\"Network \\u0026 Infrastructure\\\"}],[\\\"$\\\",\\\"time\\\",null,{\\\"dateTime\\\":\\\"2026-08-17\\\",\\\"children\\\":\\\"2026-08-17\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\\\",\\\"children\\\":\\\"The Network That Worked Until It Didn't\\\"}],[\\\"$\\\",\\\"figure\\\",null,{\\\"className\\\":\\\"mt-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative flex justify-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute -inset-4 bg-green/[0.06] blur-2xl\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\\\",\\\"alt\\\":\\\"The Network That Worked Until It Didn't\\\",\\\"className\\\":\\\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\\\"}]]}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\\\",\\\"children\\\":\\\"Fig. 01 — The frayed cable bundle.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"journal-body mt-14\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$17\\\"}}],\\\"$L18\\\",\\\"$L19\\\"]}]}]}]\\n1a:I[22016,[\\\"$2\\\",\\\"$3\\\"],\\\"\\\"]\\n18:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-16 border-t border-ink/10 pt-10\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20just%20read%20the%20journal.%20I%20think%20my%20business%20has%20a%20systems%20problem.\\\",\\\"target\\\":\\\"_blank\\\",\\\"className\\\":\\\"group inline-flex items-center gap-2 border-b border-ink/30 pb-1 text-sm uppercase tracking-widest transition-colors hover:border-green hover:text-green\\\",\\\"children\\\":[\\\"Begin the diagnostic\\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"width\\\":\\\"11\\\",\\\"height\\\":\\\"11\\\",\\\"viewBox\\\":\\\"0 0 12 12\\\",\\\"fill\\\":\\\"none\\\",\\\"className\\\":\\\"transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M2 10L10 2M10 2H4M10 2V8\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"1.2\\\"}]}]]}]}]\\n19:[\\\"$\\\",\\\"$L1a\\\",null,{\\\"href\\\":\\\"/journal\\\",\\\"className\\\":\\\"mt-10 inline-block text-sm text-muted transition-colors hover:text-ink\\\",\\\"children\\\":\\\"← All field reports\\\"}]\\n12:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n15:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"The Network That Worked Until It Didn't | Sonny Sayi Solutions\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Indoor cable exposed to the sun. Unmanaged switches. No patch panels. No documentation. A school network built to get by, not to support hundreds of students.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"2\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"The Network That Worked Until It Didn't\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Indoor cable exposed to the sun. Unmanaged switches. No patch panels. No documentation. A school network built to get by, not to support hundreds of students.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:image\\\",\\\"content\\\":\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"The Network That Worked Until It Didn't\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Indoor cable exposed to the sun. Unmanaged switches. No patch panels. No documentation. A school network built to get by, not to support hundreds of students.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\\\"}]]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:\"/_next/static/chunks/3qfy96eoyh-ek.js\"\n3:\"/_next/static/chunks/1_q4oc079m3pu.js\"\n4:I[84834,[\"$2\",\"$3\"],\"default\"]\n5:I[88115,[\"$2\",\"$3\"],\"default\"]\n6:I[39756,[\"$2\",\"$3\"],\"default\"]\n7:I[37457,[\"$2\",\"$3\"],\"default\"]\nd:I[97367,[\"$2\",\"$3\"],\"OutletBoundary\"]\ne:\"$Sreact.suspense\"\n10:\"ViewportBoundary\"\n11:I[97367,[\"$2\",\"$3\"],\"$10\"]\n13:\"MetadataBoundary\"\n14:I[97367,[\"$2\",\"$3\"],\"$13\"]\n16:I[68027,[\"$2\