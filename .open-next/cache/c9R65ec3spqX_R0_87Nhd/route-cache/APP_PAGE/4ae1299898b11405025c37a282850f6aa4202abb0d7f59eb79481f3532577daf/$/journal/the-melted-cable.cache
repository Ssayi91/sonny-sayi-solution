":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3qfy96eoyh-ek.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_q4oc079m3pu.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"scroll-smooth\",\"children\":[\"$\",\"body\",null,{\"className\":\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\",\"children\":[[\"$\",\"$L4\",null,{}],[\"$\",\"$L5\",null,{}],[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]}]]}],\"p\":false,\"v\":null},\"c\":\"$Q8\"},\"h\":{\"r\":[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L11\",null,{\"children\":\"$L12\"}],[\"$\",\"$L14\",null,{\"children\":[[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$e\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L15\"}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],\"p\":false,\"v\":null}},\"m\":\"$undefined\",\"G\":[\"$16\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"c9R65ec3spqX_R0_87Nhd\"}\n:HL[\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\",\"image\"]\n9:C\n17:Tc5f,<p>The call came during a school day.</p>\n<p>Students were trying to access online resources. Several computers had already lost connectivity. Staff couldn't tell where the fault was, only that parts of the network kept disappearing.</p>\n<p>The network had not failed overnight.</p>\n<p>It had been failing slowly for years.</p>\n<h2>What we found</h2>\n<p>Walking through the campus, the first issue was visible before opening a single cabinet.</p>\n<p>A section of the network linking school buildings had been installed using <strong>indoor Ethernet cable on an outdoor run</strong>. Years of sun exposure had hardened and damaged the cable jacket. The link was no longer reliable.</p>\n<p>Inside the buildings, the story continued.</p>\n<ul>\n<li>No patch panels.</li>\n<li>No structured cable management.</li>\n<li>No proper trunking in several runs.</li>\n<li>Multiple unmanaged switches distributed across the network.</li>\n<li>Little visibility into where cables started or ended.</li>\n<li>Several computers disconnected or improperly terminated.</li>\n</ul>\n<p>Nothing looked catastrophic in isolation.</p>\n<p>Together, however, every future fault became harder to find, harder to diagnose and more disruptive to learning.</p>\n<h2>The real problem</h2>\n<p>The damaged outdoor cable was only the symptom.</p>\n<p>The larger issue was that the network had grown without structure.</p>\n<p>New devices had been added whenever they were needed. Additional cables had been pulled whenever someone needed another connection. Small decisions accumulated over time until nobody had a clear view of the entire network.</p>\n<p>When something stopped working, troubleshooting became a process of elimination rather than a process of management.</p>\n<h2>Why this matters</h2>\n<p>Schools depend on connectivity far more than they did a decade ago.</p>\n<p>Student portals, administration systems, online learning resources, examinations, printers and communication platforms all rely on the same infrastructure.</p>\n<p>When the network becomes unreliable, teaching time is lost, administrative work slows down and students feel the impact immediately.</p>\n<h2>The work</h2>\n<p>The damaged runs were identified and replaced with proper outdoor-rated cable where required.</p>\n<p>Existing cable routes were reorganised and properly terminated.</p>\n<p>Network points that had lost connectivity were tested and restored.</p>\n<p>Computers that could not access the network were traced, diagnosed and brought back online.</p>\n<p>The goal was not to add complexity.</p>\n<p>The goal was to restore reliability and create a network that staff could depend on every day.</p>\n<h2>The lesson</h2>\n<p>Most network failures are not caused by a single dramatic event.</p>\n<p>They come from years of shortcuts.</p>\n<p>The wrong cable in the wrong environment.\nThe missing labels.\nThe unmanaged growth.\nThe assumption that if it works today, it will work tomorrow.</p>\n<p>Eventually those shortcuts become the outage.</p>\n<hr>\n<p>If your organisation relies on a network that nobody fully understands, the problem is rarely the latest fault.</p>\n<p>The problem is usually the system underneath it.</p>\nc:[\"$\",\"main\",null,{\"className\":\"pt-28 md:pt-32\",\"children\":[\"$\",\"article\",null,{\"className\":\"px-6 py-16 md:px-16 md:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-green\",\"children\":\"Network & Infrastructure\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-08-17\",\"children\":\"2026-08-17\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\",\"children\":\"The Network That Worked Until It Didn't\"}],[\"$\",\"figure\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -inset-4 bg-green/[0.06] blur-2xl\",\"aria-hidden\":\"true\"}],[\"$\",\"img\",null,{\"src\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/frayed-cable-bundle_whifkh.png\",\"alt\":\"The Network That Worked Until It Didn't\",\"className\":\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\"}]]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":\"Fig. 01 — The frayed cable bundle.\"}]]}],[\"$\",\"div\",null,{\"className\":\"journal-body mt-14\",\"dangerouslySetInnerHTML\":{\"__html\":\"$17\"}}],\"$L18\",\"$L19\"]}]}]}]\n1a:I[22016,[\"$2\",\"$3\"],\"\"]\n18:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-ink/10 pt-10\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://wa.