\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line></svg></span><span>Field Reports</span></a><a href=\"/#proof\" class=\"flex items-center gap-4 border-b border-ink/10 pb-6 font-serif text-3xl font-semibold text-ink transition-colors hover:text-green\"><span class=\"text-muted\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"></line><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"></line></svg></span><span>Portfolio</span></a><a href=\"/journal\" class=\"flex items-center gap-4 border-b border-ink/10 pb-6 font-serif text-3xl font-semibold text-ink transition-colors hover:text-green\"><span class=\"text-muted\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"></path><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"></path></svg></span><span>The Journal</span></a><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20think%20my%20business%20has%20a%20systems%20problem.\" target=\"_blank\" class=\"mt-4 flex items-center gap-4 text-2xl text-green\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg><span>Begin Diagnostic</span></a></nav><div class=\"absolute bottom-8 left-8 right-8 flex justify-between font-mono text-[10px] uppercase tracking-[0.3em] text-muted\"><span>Nairobi, KE</span><span>Vol. 01</span></div></div><div class=\"fixed bottom-6 right-6 z-30 flex flex-col items-end gap-4\"><button aria-label=\"Chat on WhatsApp\" class=\"relative flex h-14 w-14 items-center justify-center rounded-full border border-green/40 bg-deep/90 text-green shadow-[0_0_25px_rgba(34,197,94,0.25)] backdrop-blur-md transition-all hover:bg-green hover:text-deep\"><span class=\"pointer-events-none absolute inset-0 rounded-full bg-green/20 blur-md animate-breathe\"></span><svg class=\"relative h-6 w-6\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z\"></path></svg></button></div><main class=\"pt-28 md:pt-32\"><article class=\"px-6 py-16 md:px-16 md:py-24\"><div class=\"mx-auto max-w-3xl\"><div class=\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\"><span class=\"text-green\">Custom Applications</span><time dateTime=\"2026-08-17\">2026-08-17</time></div><h1 class=\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\">Your Business Should Not Need a Human Bridge Between Every System</h1><figure class=\"mt-12\"><div class=\"relative flex justify-center\"><div class=\"absolute -inset-4 bg-green/[0.06] blur-2xl\" aria-hidden=\"true\"></div><img src=\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\" alt=\"Your Business Should Not Need a Human Bridge Between Every System\" class=\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\"/></div><figcaption class=\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\">Fig. 05 — The Friday-night reconciliation desk.</figcaption></figure><div class=\"journal-body mt-14\"><p>There is a strange point in the life of a growing business.</p>\n<p>The business is busy.</p>\n<p>Customers are coming in. Orders are moving. Staff are working.</p>\n<p>And yet, somehow, everyone is spending their day doing things that should have stopped requiring a person years ago.</p>\n<p>Someone copies an order from WhatsApp into Excel.</p>\n<p>Someone checks whether the payment came in.</p>\n<p>Someone sends a screenshot to another department.</p>\n<p>Someone updates the spreadsheet.</p>\n<p>Someone calls the driver.</p>\n<p>Someone asks whether the customer was contacted.</p>\n<p>Someone spends Friday afternoon making sure everyone did what the system should have tracked automatically.</p>\n<p>The business is functioning.</p>\n<p>But the workflow is being held together by people.</p>\n<h2>The WhatsApp-to-Excel pipeline</h2>\n<p>It usually starts innocently.</p>\n<p>A customer sends an order through WhatsApp.</p>\n<p>The sales person writes it down.</p>\n<p>Later, someone enters it into a spreadsheet.</p>\n<p>The warehouse receives a message.</p>\n<p>The accounts team gets another message.</p>\n<p>The customer asks for an update.</p>\n<p>Someone searches through the chat.</p>\n<p>The order is eventually delivered.</p>\n<p>Then someone has to reconcile everything.</p>\n<p>None of these steps is particularly complicated.</p>\n<p>That is exactly why they become dangerous.</p>\n<p>When a simple process happens hundreds of times, every manual handoff becomes another opportunity for something to be missed.</p>\n<p>A number gets typed incorrectly.</p>\n<p>A message gets buried.</p>\n<p>A payment is not matched.</p>\n<p>An order is duplicated.</p>\n<p>A customer waits for an update that somebody forgot to send.</p>\n<p>The problem isn't that your employees are careless.</p>\n<p><strong>The process is asking them to remember too much.</strong></p>\n<h2>When Excel becomes the database</h2>\n<p>Spreadsheets are excellent tools.</p>\n<p>They become a problem when the entire operation depends on them.</p>\n<p>One spreadsheet tracks customers.</p>\n<p>Another tracks stock.</p>\n<p>Someone has their own version.</p>\n<p>Another person keeps the \"master\" copy.</p>\n<p>Then somebody sends the latest file through WhatsApp.</p>\n<p>Six months later, nobody is completely sure which version is correct.</p>\n<p>At that point, Excel is no longer just a spreadsheet.</p>\n<p>It has become an unofficial business system.</p>\n<p>And unofficial systems are difficult to control, audit or scale.</p>\n<h2>The employee who knows everything</h2>\n<p>Every growing business eventually has one.</p>\n<p>The person everyone calls when something doesn't make sense.</p>\n<p>They know where the files are.</p>\n<p>They know which spreadsheet is current.</p>\n<p>They know which customer paid.</p>\n<p>They know which orders are waiting.</p>\n<p>They know which approval is still pending.</p>\n<p>They know the workaround.</p>\n<p>If that person is on leave, the workflow slows down.</p>\n<p>If they leave the company, part of the company's operational knowledge leaves with them.</p>\n<p>That is not an employee problem.</p>\n<p>It is a systems problem.</p>\n<p>Knowledge that matters to the business should not exist only inside someone's memory.</p>\n<h2>Automation is not about replacing people</h2>\n<p>Good automation does not begin with:</p>\n<p><strong>\"How many employees can we eliminate?\"</strong></p>\n<p>It begins with:</p>\n<p><strong>\"Why are highly capable people spending their time doing this?\"</strong></p>\n<p>If a person has to repeatedly copy information from one place to another, that is a candidate for automation.</p>\n<p>If someone has to manually calculate the same figure every day, that is a candidate for automation.</p>\n<p>If a manager has to ask three people for the status of an order, that is a workflow problem.</p>\n<p>If a customer has to wait for someone to find information that already exists in your business, the information is in the wrong place.</p>\n<p>The goal is not fewer people.</p>\n<p>The goal is fewer unnecessary steps.</p>\n<h2>What a proper workflow looks like</h2>\n<p>Imagine a customer places an order.</p>\n<p>The system records it.</p>\n<p>The relevant team is notified.</p>\n<p>Stock is checked.</p>\n<p>The order moves to fulfilment.</p>\n<p>The customer receives an update.</p>\n<p>Payment is recorded.</p>\n<p>The delivery is logged.</p>\n<p>The sale appears in the dashboard.</p>\n<p>Management can see what happened without asking five people.</p>\n<p>Nobody had to copy the same information into four different places.</p>\n<p>That is what a business system should do.</p>\n<p>It should carry information forward.</p>\n<h2>The cure</h2>\n<p>We build the system around the way your business actually operates.</p>\n<p>That can mean:</p>\n<ul>\n<li><strong>Custom dashboards</strong> that replace scattered spreadsheets.</li>\n<li><strong>Order management</strong> that takes work out of WhatsApp and into a structured workflow.</li>\n<li><strong>CRM systems</strong> that keep customer information and follow-ups in one place.</li>\n<li><strong>Inventory systems</strong> that connect stock, sales and fulfilment.</li>\n<li><strong>Approval workflows</strong> that show exactly what is waiting and who needs to act.</li>\n<li><strong>Automated reports</strong> that remove repetitive reporting work.</li>\n<li><strong>Notifications and reminders</strong> that happen because the system knows they need to happen.</li>\n<li><strong>Integrations</strong> that move information between the tools your business already uses.</li>\n</ul>\n<p>We don't automate a process simply because automation sounds impressive.</p>\n<p>First, we map the workflow.</p>\n<p>Then we find the bottlenecks.</p>\n<p>Then we decide what should be removed, what should be automated and where a person actually needs to stay involved.</p>\n<p>The result is not another piece of software your team has to fight with.</p>\n<p>It is a system that fits the way the business already works.</p>\n<hr>\n<p>Your people should be making decisions, serving customers and moving the business forward.</p>\n<p>They should not spend their day copying information between systems, hunting through WhatsApp messages or rebuilding reports that the business has already generated.</p>\n<p>If the same task happens every day, the same information is entered more than once, or the same person has to manually keep the operation connected, there is probably a better way to run it.</p>\n<p><strong>That's where we come in.</strong></p>\n<p><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20report%20on%20workflow%20and%20automation.%20We%20have%20manual%20processes%20that%20need%20to%20be%20fixed.\">Begin the diagnostic</a></p>\n</div><div class=\"mt-16 border-t border-ink/10 pt-10\"><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20just%20read%20the%20journal.%20I%20think%20my%20business%20has%20a%20systems%20problem.\" target=\"_blank\" class=\"group inline-flex items-center gap-2 border-b border-ink/30 pb-1 text-sm uppercase tracking-widest transition-colors hover:border-green hover:text-green\">Begin the diagnostic<svg width=\"11\" height=\"11\" viewBox=\"0 0 12 12\" fill=\"none\" class=\"transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\"><path d=\"M2 10L10 2M10 2H4M10 2V8\" stroke=\"currentColor\" stroke-width=\"1.2\"></path></svg></a></div><a class=\"mt-10 inline-block text-sm text-muted transition-colors hover:text-ink\" href=\"/journal\">← All field reports</a></div></article></main><!--$--><!--/$--><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/1pcw6gskne7pf.js\",\"static/chunks/0vm8zo6v48m9c.js\",\"static/chunks/2-liacn1-fmrj.js\",\"static/chunks/3ncqdelv46e8a.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/1pcw6gskne7pf.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:\\\"/_next/static/chunks/3qfy96eoyh-ek.js\\\"\\n3:\\\"/_next/static/chunks/1_q4oc079m3pu.js\\\"\\n4:I[84834,[\\\"$2\\\",\\\"$3\\\"],\\\"default\\\"]\\n5:I[88115,[\\\"$2\\\",\\\"$3\\\"],\\\"default\\\"]\\n6:I[39756,[\\\"$2\\\",\\\"$3\\\"],\\\"default\\\"]\\n7:I[37457,[\\\"$2\\\",\\\"$3\\\"],\\\"default\\\"]\\nd:I[97367,[\\\"$2\\\",\\\"$3\\\"],\\\"OutletBoundary\\\"]\\ne:\\\"$Sreact.suspense\\\"\\n10:\\\"ViewportBoundary\\\"\\n11:I[97367,[\\\"$2\\\",\\\"$3\\\"],\\\"$10\\\"]\\n13:\\\"MetadataBoundary\\\"\\n14:I[97367,[\\\"$2\\\",\\\"$3\\\"],\\\"$13\\\"]\\n16:I[68027,[\\\"$2\\\",\\\"$3\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/1pw566iu1r5qg.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/068444135650a82f-s.p.24u93d7s5mbjp.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/07c7676b89ed2778-s.p.2bn3s6zvc0dyp.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/c4d7be43e05ae6b0-s.p.2-8nwwlkvso64.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n9:X\\nb:[[\\\"children\\\",{\\\"s\\\":\\\"__PAGE__\\\",\\\"h\\\":512,\\\"d\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[\\\"$Lc\\\",null,[\\\"$\\\",\\\"$Ld\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$e\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@f\\\"}]}]]}],\\\"p\\\":false,\\\"v\\\":null}}]]\\na:[[\\\"children\\\",{\\\"s\\\":{\\\"n\\\":\\\"slug\\\",\\\"t\\\":\\\"d\\\",\\\"k\\\":\\\"manual-workflow\\\",\\\"s\\\":[]},\\\"h\\\":512,\\\"d\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L6\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L7\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}],\\\"p\\\":false,\\\"v\\\":\\\"$9\\\"},\\\"c\\\":\\\"$Qb\\\"}]]\\n8:[[\\\"children\\\",{\\\"s\\\":\\\"journal\\\",\\\"h\\\":512,\\\"d\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L6\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L7\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}],\\\"p\\\":false,\\\"v\\\":\\\"$9\\\"},\\\"c\\\":\\\"$Qa\\\"}]]\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"journal\\\",\\\"manual-workflow\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"t\\\":{\\\"t\\\":{\\\"s\\\":\\\"\\\",\\\"h\\\":528,\\\"d\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/1pw566iu1r5qg.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/3qfy96eoyh-ek.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-1\\\",{\\\"src\\\":\\\"/_next/static/chunks/1_q4oc079m3pu.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"className\\\":\\\"scroll-smooth\\\",\\\"children\\\":[\\\"$\\\",\\\"body\\\",null,{\\\"className\\\":\\\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L4\\\",null,{}],[\\\"$\\\",\\\"$L5\\\",null,{}],[\\\"$\\\",\\\"$L6\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L7\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":[[[\\\"$\\\",\\\"title\\\",null,{\\\"children\\\":\\\"404: This page could not be found.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"fontFamily\\\":\\\"system-ui,\\\\\\\"Segoe UI\\\\\\\",Roboto,Helvetica,Arial,sans-serif,\\\\\\\"Apple Color Emoji\\\\\\\",\\\\\\\"Segoe UI Emoji\\\\\\\"\\\",\\\"height\\\":\\\"100vh\\\",\\\"textAlign\\\":\\\"center\\\",\\\"display\\\":\\\"flex\\\",\\\"flexDirection\\\":\\\"column\\\",\\\"alignItems\\\":\\\"center\\\",\\\"justifyContent\\\":\\\"center\\\"},\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\\\"}}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"next-error-h1\\\",\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\",\\\"margin\\\":\\\"0 20px 0 0\\\",\\\"padding\\\":\\\"0 23px 0 0\\\",\\\"fontSize\\\":24,\\\"fontWeight\\\":500,\\\"verticalAlign\\\":\\\"top\\\",\\\"lineHeight\\\":\\\"49px\\\"},\\\"children\\\":404}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\"},\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"fontSize\\\":14,\\\"fontWeight\\\":400,\\\"lineHeight\\\":\\\"49px\\\",\\\"margin\\\":0},\\\"children\\\":\\\"This page could not be found.\\\"}]}]]}]}]],[]],\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}]}]]}],\\\"p\\\":false,\\\"v\\\":null},\\\"c\\\":\\\"$Q8\\\"},\\\"h\\\":{\\\"r\\\":[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L11\\\",null,{\\\"children\\\":\\\"$L12\\\"}],[\\\"$\\\",\\\"$L14\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$e\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L15\\\"}]}],null]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],\\\"p\\\":false,\\\"v\\\":null}},\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$16\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/1pw566iu1r5qg.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"r\\\":\\\"$undefined\\\",\\\"s\\\":\\\"$undefined\\\",\\\"a\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"c9R65ec3spqX_R0_87Nhd\\\"}\\n:HL[\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\\\",\\\"image\\\"]\\n9:C\\n17:T1a18,\\u003cp\\u003eThere is a strange point in the life of a growing business.\\u003c/p\\u003e\\n\\u003cp\\u003eThe business is busy.\\u003c/p\\u003e\\n\\u003cp\\u003eCustomers are coming in. Orders are moving. Staff are working.\\u003c/p\\u003e\\n\\u003cp\\u003eAnd yet, somehow, everyone is spending their day doing things that should have stopped requiring a person years ago.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone copies an order from WhatsApp into Excel.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone checks whether the payment came in.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone sends a screenshot to another department.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone updates the spreadsheet.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone calls the driver.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone asks whether the customer was contacted.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone spends Friday afternoon making sure everyone did what the system should have tracked automatically.\\u003c/p\\u003e\\n\\u003cp\\u003eThe business is functioning.\\u003c/p\\u003e\\n\\u003cp\\u003eBut the workflow is being held together by people.\\u003c/p\\u003e\\n\\u003ch2\\u003eThe WhatsApp-to-Excel pipeline\\u003c/h2\\u003e\\n\\u003cp\\u003eIt usually starts innocently.\\u003c/p\\u003e\\n\\u003cp\\u003eA customer sends an order through WhatsApp.\\u003c/p\\u003e\\n\\u003cp\\u003eThe sales person writes it down.\\u003c/p\\u003e\\n\\u003cp\\u003eLater, someone enters it into a spreadsheet.\\u003c/p\\u003e\\n\\u003cp\\u003eThe warehouse receives a message.\\u003c/p\\u003e\\n\\u003cp\\u003eThe accounts team gets another message.\\u003c/p\\u003e\\n\\u003cp\\u003eThe customer asks for an update.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone searches through the chat.\\u003c/p\\u003e\\n\\u003cp\\u003eThe order is eventually delivered.\\u003c/p\\u003e\\n\\u003cp\\u003eThen someone has to reconcile everything.\\u003c/p\\u003e\\n\\u003cp\\u003eNone of these steps is particularly complicated.\\u003c/p\\u003e\\n\\u003cp\\u003eThat is exactly why they become dangerous.\\u003c/p\\u003e\\n\\u003cp\\u003eWhen a simple process happens hundreds of times, every manual handoff becomes another opportunity for something to be missed.\\u003c/p\\u003e\\n\\u003cp\\u003eA number gets typed incorrectly.\\u003c/p\\u003e\\n\\u003cp\\u003eA message gets buried.\\u003c/p\\u003e\\n\\u003cp\\u003eA payment is not matched.\\u003c/p\\u003e\\n\\u003cp\\u003eAn order is duplicated.\\u003c/p\\u003e\\n\\u003cp\\u003eA customer waits for an update that somebody forgot to send.\\u003c/p\\u003e\\n\\u003cp\\u003eThe problem isn't that your employees are careless.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eThe process is asking them to remember too much.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003ch2\\u003eWhen Excel becomes the database\\u003c/h2\\u003e\\n\\u003cp\\u003eSpreadsheets are excellent tools.\\u003c/p\\u003e\\n\\u003cp\\u003eThey become a problem when the entire operation depends on them.\\u003c/p\\u003e\\n\\u003cp\\u003eOne spreadsheet tracks customers.\\u003c/p\\u003e\\n\\u003cp\\u003eAnother tracks stock.\\u003c/p\\u003e\\n\\u003cp\\u003eSomeone has their own version.\\u003c/p\\u003e\\n\\u003cp\\u003eAnother person keeps the \\\"master\\\" copy.\\u003c/p\\u003e\\n\\u003cp\\u003eThen somebody sends the latest file through WhatsApp.\\u003c/p\\u003e\\n\\u003cp\\u003eSix months later, nobody is completely sure which version is correct.\\u003c/p\\u003e\\n\\u003cp\\u003eAt that point, Excel is no longer just a spreadsheet.\\u003c/p\\u003e\\n\\u003cp\\u003eIt has become an unofficial business system.\\u003c/p\\u003e\\n\\u003cp\\u003eAnd unofficial systems are difficult to control, audit or scale.\\u003c/p\\u003e\\n\\u003ch2\\u003eThe employee who knows everything\\u003c/h2\\u003e\\n\\u003cp\\u003eEvery growing business eventually has one.\\u003c/p\\u003e\\n\\u003cp\\u003eThe person everyone calls when something doesn't make sense.\\u003c/p\\u003e\\n\\u003cp\\u003eThey know where the files are.\\u003c/p\\u003e\\n\\u003cp\\u003eThey know which spreadsheet is current.\\u003c/p\\u003e\\n\\u003cp\\u003eThey know which customer paid.\\u003c/p\\u003e\\n\\u003cp\\u003eThey know which orders are waiting.\\u003c/p\\u003e\\n\\u003cp\\u003eThey know which approval is still pending.\\u003c/p\\u003e\\n\\u003cp\\u003eThey know the workaround.\\u003c/p\\u003e\\n\\u003cp\\u003eIf that person is on leave, the workflow slows down.\\u003c/p\\u003e\\n\\u003cp\\u003eIf they leave the company, part of the company's operational knowledge leaves with them.\\u003c/p\\u003e\\n\\u003cp\\u003eThat is not an employee problem.\\u003c/p\\u003e\\n\\u003cp\\u003eIt is a systems problem.\\u003c/p\\u003e\\n\\u003cp\\u003eKnowledge that matters to the business should not exist only inside someone's memory.\\u003c/p\\u003e\\n\\u003ch2\\u003eAutomation is not about replacing people\\u003c/h2\\u003e\\n\\u003cp\\u003eGood automation does not begin with:\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e\\\"How many employees can we eliminate?\\\"\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003eIt begins with:\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003e\\\"Why are highly capable people spending their time doing this?\\\"\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003eIf a person has to repeatedly copy information from one place to another, that is a candidate for automation.\\u003c/p\\u003e\\n\\u003cp\\u003eIf someone has to manually calculate the same figure every day, that is a candidate for automation.\\u003c/p\\u003e\\n\\u003cp\\u003eIf a manager has to ask three people for the status of an order, that is a workflow problem.\\u003c/p\\u003e\\n\\u003cp\\u003eIf a customer has to wait for someone to find information that already exists in your business, the information is in the wrong place.\\u003c/p\\u003e\\n\\u003cp\\u003eThe goal is not fewer people.\\u003c/p\\u003e\\n\\u003cp\\u003eThe goal is fewer unnecessary steps.\\u003c/p\\u003e\\n\\u003ch2\\u003eWhat a proper workflow looks like\\u003c/h2\\u003e\\n\\u003cp\\u003eImagine a customer places an order.\\u003c/p\\u003e\\n\\u003cp\\u003eThe system records it.\\u003c/p\\u003e\\n\\u003cp\\u003eThe relevant team is notified.\\u003c/p\\u003e\\n\\u003cp\\u003eStock is checked.\\u003c/p\\u003e\\n\\u003cp\\u003eThe order moves to fulfilment.\\u003c/p\\u003e\\n\\u003cp\\u003eThe customer receives an update.\\u003c/p\\u003e\\n\\u003cp\\u003ePayment is recorded.\\u003c/p\\u003e\\n\\u003cp\\u003eThe delivery is logged.\\u003c/p\\u003e\\n\\u003cp\\u003eThe sale appears in the dashboard.\\u003c/p\\u003e\\n\\u003cp\\u003eManagement can see what happened without asking five people.\\u003c/p\\u003e\\n\\u003cp\\u003eNobody had to copy the same information into four different places.\\u003c/p\\u003e\\n\\u003cp\\u003eThat is what a business system should do.\\u003c/p\\u003e\\n\\u003cp\\u003eIt should carry information forward.\\u003c/p\\u003e\\n\\u003ch2\\u003eThe cure\\u003c/h2\\u003e\\n\\u003cp\\u003eWe build the system around the way your business actually operates.\\u003c/p\\u003e\\n\\u003cp\\u003eThat can mean:\\u003c/p\\u003e\\n\\u003cul\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eCustom dashboards\\u003c/strong\\u003e that replace scattered spreadsheets.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eOrder management\\u003c/strong\\u003e that takes work out of WhatsApp and into a structured workflow.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eCRM systems\\u003c/strong\\u003e that keep customer information and follow-ups in one place.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eInventory systems\\u003c/strong\\u003e that connect stock, sales and fulfilment.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eApproval workflows\\u003c/strong\\u003e that show exactly what is waiting and who needs to act.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eAutomated reports\\u003c/strong\\u003e that remove repetitive reporting work.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eNotifications and reminders\\u003c/strong\\u003e that happen because the system knows they need to happen.\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cstrong\\u003eIntegrations\\u003c/strong\\u003e that move information between the tools your business already uses.\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\n\\u003cp\\u003eWe don't automate a process simply because automation sounds impressive.\\u003c/p\\u003e\\n\\u003cp\\u003eFirst, we map the workflow.\\u003c/p\\u003e\\n\\u003cp\\u003eThen we find the bottlenecks.\\u003c/p\\u003e\\n\\u003cp\\u003eThen we decide what should be removed, what should be automated and where a person actually needs to stay involved.\\u003c/p\\u003e\\n\\u003cp\\u003eThe result is not another piece of software your team has to fight with.\\u003c/p\\u003e\\n\\u003cp\\u003eIt is a system that fits the way the business already works.\\u003c/p\\u003e\\n\\u003chr\\u003e\\n\\u003cp\\u003eYour people should be making decisions, serving customers and moving the business forward.\\u003c/p\\u003e\\n\\u003cp\\u003eThey should not spend their day copying information between systems, hunting through WhatsApp messages or rebuilding reports that the business has already generated.\\u003c/p\\u003e\\n\\u003cp\\u003eIf the same task happens every day, the same information is entered more than once, or the same person has to manually keep the operation connected, there is probably a better way to run it.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003cstrong\\u003eThat's where we come in.\\u003c/strong\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003ca href=\\\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20report%20on%20workflow%20and%20automation.%20We%20have%20manual%20processes%20that%20need%20to%20be%20fixed.\\\"\\u003eBegin the diagnostic\\u003c/a\\u003e\\u003c/p\\u003e\\nc:[\\\"$\\\",\\\"main\\\",null,{\\\"className\\\":\\\"pt-28 md:pt-32\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"px-6 py-16 md:px-16 md:py-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-3xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-green\\\",\\\"children\\\":\\\"Custom Applications\\\"}],[\\\"$\\\",\\\"time\\\",null,{\\\"dateTime\\\":\\\"2026-08-17\\\",\\\"children\\\":\\\"2026-08-17\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\\\",\\\"children\\\":\\\"Your Business Should Not Need a Human Bridge Between Every System\\\"}],[\\\"$\\\",\\\"figure\\\",null,{\\\"className\\\":\\\"mt-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative flex justify-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute -inset-4 bg-green/[0.06] blur-2xl\\\",\\\"aria-hidden\\\":\\\"true\\\"}],[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\\\",\\\"alt\\\":\\\"Your Business Should Not Need a Human Bridge Between Every System\\\",\\\"className\\\":\\\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\\\"}]]}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\\\",\\\"children\\\":\\\"Fig. 05 — The Friday-night reconciliation desk.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"journal-body mt-14\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$17\\\"}}],\\\"$L18\\\",\\\"$L19\\\"]}]}]}]\\n1a:I[22016,[\\\"$2\\\",\\\"$3\\\"],\\\"\\\"]\\n18:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-16 border-t border-ink/10 pt-10\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20just%20read%20the%20journal.%20I%20think%20my%20business%20has%20a%20systems%20problem.\\\",\\\"target\\\":\\\"_blank\\\",\\\"className\\\":\\\"group inline-flex items-center gap-2 border-b border-ink/30 pb-1 text-sm uppercase tracking-widest transition-colors hover:border-green hover:text-green\\\",\\\"children\\\":[\\\"Begin the diagnostic\\\",[\\\"$\\\",\\\"svg\\\",null,{\\\"width\\\":\\\"11\\\",\\\"height\\\":\\\"11\\\",\\\"viewBox\\\":\\\"0 0 12 12\\\",\\\"fill\\\":\\\"none\\\",\\\"className\\\":\\\"transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M2 10L10 2M10 2H4M10 2V8\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"1.2\\\"}]}]]}]}]\\n19:[\\\"$\\\",\\\"$L1a\\\",null,{\\\"href\\\":\\\"/journal\\\",\\\"className\\\":\\\"mt-10 inline-block text-sm text-muted transition-colors hover:text-ink\\\",\\\"children\\\":\\\"← All field reports\\\"}]\\n12:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n15:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Your Business Should Not Need a Human Bridge Between Every System | Sonny Sayi Solutions\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"2\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Your Business Should Not Need a Human Bridge Between Every System\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:image\\\",\\\"content\\\":\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Your Business Should Not Need a Human Bridge Between Every System\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\\\"}]]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:\"/_next/static/chunks/3qfy96eoyh-ek.js\"\n3:\"/_next/static/chunks/1_q4oc079m3pu.js\"\n4:I[84834,[\"$2\",\"$3\"],\"default\"]\n5:I[88115,[\"$2\",\"$3\"],\"default\"]\n6:I[39756,[\"$2\",\"$3\"],\"default\"]\n7:I[37457,[\"$2\",\"$3\"],\"default\"]\nd:I[97367,[\"$2\",\"$3\"],\"OutletBoundary\"]\ne:\"$Sreact.suspense\"\n10:\"ViewportBoundary\"\n11:I[97367,[\"$2\",\"$3\"],\"$10\"]\n13:\"MetadataBoundary\"\n14:I[97367,[\"$2\",\"$3\"],\"$13\"]\n16:I[68027,[\"$2\",\"$3\"],\"default\",1]\n:HL[\"/_next/static/chunks/1pw566iu1r5qg.css\",\"style\"]\n:HL[\"/_next/static/media/068444135650a82f-s.p.24u93d7s5mbjp.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/07c7676b89ed2778-s.p.2bn3s6zvc0dyp.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/c4d7be43e05ae6b0-s.p.2-8nwwlkvso64.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n9:X\nb:[[\"children\",{\"s\":\"__PAGE__\",\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[\"$Lc\",null,[\"$\",\"$Ld\",null,{\"children\":[\"$\",\"$e\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@f\"}]}]]}],\"p\":false,\"v\":null}}]]\na:[[\"children\",{\"s\":{\"n\":\"slug\",\"t\":\"d\",\"k\":\"manual-workflow\",\"s\":[]},\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"p\":false,\"v\":\"$9\"},\"c\":\"$Qb\"}]]\n8:[[\"children\",{\"s\":\"journal\",\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"p\":false,\"v\":\"$9\"},\"c\":\"$Qa\"}]]\n0:{\"P\":null,\"c\":[\"\",\"journal\",\"manual-workflow\"],\"q\":\"\",\"i\":false,\"t\":{\"t\":{\"s\":\"\",\"h\":528,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3qfy96eoyh-ek.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_q4oc079m3pu.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"scroll-smooth\",\"children\":[\"$\",\"body\",null,{\"className\":\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\",\"children\":[[\"$\",\"$L4\",null,{}],[\"$\",\"$L5\",null,{}],[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]}]]}],\"p\":false,\"v\":null},\"c\":\"$Q8\"},\"h\":{\"r\":[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L11\",null,{\"children\":\"$L12\"}],[\"$\",\"$L14\",null,{\"children\":[[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$e\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L15\"}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],\"p\":false,\"v\":null}},\"m\":\"$undefined\",\"G\":[\"$16\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"c9R65ec3spqX_R0_87Nhd\"}\n:HL[\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\",\"image\"]\n9:C\n17:T1a18,<p>There is a strange point in the life of a growing business.</p>\n<p>The business is busy.</p>\n<p>Customers are coming in. Orders are moving. Staff are working.</p>\n<p>And yet, somehow, everyone is spending their day doing things that should have stopped requiring a person years ago.</p>\n<p>Someone copies an order from WhatsApp into Excel.</p>\n<p>Someone checks whether the payment came in.</p>\n<p>Someone sends a screenshot to another department.</p>\n<p>Someone updates the spreadsheet.</p>\n<p>Someone calls the driver.</p>\n<p>Someone asks whether the customer was contacted.</p>\n<p>Someone spends Friday afternoon making sure everyone did what the system should have tracked automatically.</p>\n<p>The business is functioning.</p>\n<p>But the workflow is being held together by people.</p>\n<h2>The WhatsApp-to-Excel pipeline</h2>\n<p>It usually starts innocently.</p>\n<p>A customer sends an order through WhatsApp.</p>\n<p>The sales person writes it down.</p>\n<p>Later, someone enters it into a spreadsheet.</p>\n<p>The warehouse receives a message.</p>\n<p>The accounts team gets another message.</p>\n<p>The customer asks for an update.</p>\n<p>Someone searches through the chat.</p>\n<p>The order is eventually delivered.</p>\n<p>Then someone has to reconcile everything.</p>\n<p>None of these steps is particularly complicated.</p>\n<p>That is exactly why they become dangerous.</p>\n<p>When a simple process happens hundreds of times, every manual handoff becomes another opportunity for something to be missed.</p>\n<p>A number gets typed incorrectly.</p>\n<p>A message gets buried.</p>\n<p>A payment is not matched.</p>\n<p>An order is duplicated.</p>\n<p>A customer waits for an update that somebody forgot to send.</p>\n<p>The problem isn't that your employees are careless.</p>\n<p><strong>The process is asking them to remember too much.</strong></p>\n<h2>When Excel becomes the database</h2>\n<p>Spreadsheets are excellent tools.</p>\n<p>They become a problem when the entire operation depends on them.</p>\n<p>One spreadsheet tracks customers.</p>\n<p>Another tracks stock.</p>\n<p>Someone has their own version.</p>\n<p>Another person keeps the \"master\" copy.</p>\n<p>Then somebody sends the latest file through WhatsApp.</p>\n<p>Six months later, nobody is completely sure which version is correct.</p>\n<p>At that point, Excel is no longer just a spreadsheet.</p>\n<p>It has become an unofficial business system.</p>\n<p>And unofficial systems are difficult to control, audit or scale.</p>\n<h2>The employee who knows everything</h2>\n<p>Every growing business eventually has one.</p>\n<p>The person everyone calls when something doesn't make sense.</p>\n<p>They know where the files are.</p>\n<p>They know which spreadsheet is current.</p>\n<p>They know which customer paid.</p>\n<p>They know which orders are waiting.</p>\n<p>They know which approval is still pending.</p>\n<p>They know the workaround.</p>\n<p>If that person is on leave, the workflow slows down.</p>\n<p>If they leave the company, part of the company's operational knowledge leaves with them.</p>\n<p>That is not an employee problem.</p>\n<p>It is a systems problem.</p>\n<p>Knowledge that matters to the business should not exist only inside someone's memory.</p>\n<h2>Automation is not about replacing people</h2>\n<p>Good automation does not begin with:</p>\n<p><strong>\"How many employees can we eliminate?\"</strong></p>\n<p>It begins with:</p>\n<p><strong>\"Why are highly capable people spending their time doing this?\"</strong></p>\n<p>If a person has to repeatedly copy information from one place to another, that is a candidate for automation.</p>\n<p>If someone has to manually calculate the same figure every day, that is a candidate for automation.</p>\n<p>If a manager has to ask three people for the status of an order, that is a workflow problem.</p>\n<p>If a customer has to wait for someone to find information that already exists in your business, the information is in the wrong place.</p>\n<p>The goal is not fewer people.</p>\n<p>The goal is fewer unnecessary steps.</p>\n<h2>What a proper workflow looks like</h2>\n<p>Imagine a customer places an order.</p>\n<p>The system records it.</p>\n<p>The relevant team is notified.</p>\n<p>Stock is checked.</p>\n<p>The order moves to fulfilment.</p>\n<p>The customer receives an update.</p>\n<p>Payment is recorded.</p>\n<p>The delivery is logged.</p>\n<p>The sale appears in the dashboard.</p>\n<p>Management can see what happened without asking five people.</p>\n<p>Nobody had to copy the same information into four different places.</p>\n<p>That is what a business system should do.</p>\n<p>It should carry information forward.</p>\n<h2>The cure</h2>\n<p>We build the system around the way your business actually operates.</p>\n<p>That can mean:</p>\n<ul>\n<li><strong>Custom dashboards</strong> that replace scattered spreadsheets.</li>\n<li><strong>Order management</strong> that takes work out of WhatsApp and into a structured workflow.</li>\n<li><strong>CRM systems</strong> that keep customer information and follow-ups in one place.</li>\n<li><strong>Inventory systems</strong> that connect stock, sales and fulfilment.</li>\n<li><strong>Approval workflows</strong> that show exactly what is waiting and who needs to act.</li>\n<li><strong>Automated reports</strong> that remove repetitive reporting work.</li>\n<li><strong>Notifications and reminders</strong> that happen because the system knows they need to happen.</li>\n<li><strong>Integrations</strong> that move information between the tools your business already uses.</li>\n</ul>\n<p>We don't automate a process simply because automation sounds impressive.</p>\n<p>First, we map the workflow.</p>\n<p>Then we find the bottlenecks.</p>\n<p>Then we decide what should be removed, what should be automated and where a person actually needs to stay involved.</p>\n<p>The result is not another piece of software your team has to fight with.</p>\n<p>It is a system that fits the way the business already works.</p>\n<hr>\n<p>Your people should be making decisions, serving customers and moving the business forward.</p>\n<p>They should not spend their day copying information between systems, hunting through WhatsApp messages or rebuilding reports that the business has already generated.</p>\n<p>If the same task happens every day, the same information is entered more than once, or the same person has to manually keep the operation connected, there is probably a better way to run it.</p>\n<p><strong>That's where we come in.</strong></p>\n<p><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20report%20on%20workflow%20and%20automation.%20We%20have%20manual%20processes%20that%20need%20to%20be%20fixed.\">Begin the diagnostic</a></p>\nc:[\"$\",\"main\",null,{\"className\":\"pt-28 md:pt-32\",\"children\":[\"$\",\"article\",null,{\"className\":\"px-6 py-16 md:px-16 md:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-green\",\"children\":\"Custom Applications\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-08-17\",\"children\":\"2026-08-17\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\",\"children\":\"Your Business Should Not Need a Human Bridge Between Every System\"}],[\"$\",\"figure\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -inset-4 bg-green/[0.06] blur-2xl\",\"aria-hidden\":\"true\"}],[\"$\",\"img\",null,{\"src\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\",\"alt\":\"Your Business Should Not Need a Human Bridge Between Every System\",\"className\":\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\"}]]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":\"Fig. 05 — The Friday-night reconciliation desk.\"}]]}],[\"$\",\"div\",null,{\"className\":\"journal-body mt-14\",\"dangerouslySetInnerHTML\":{\"__html\":\"$17\"}}],\"$L18\",\"$L19\"]}]}]}]\n1a:I[22016,[\"$2\",\"$3\"],\"\"]\n18:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-ink/10 pt-10\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20just%20read%20the%20journal.%20I%20think%20my%20business%20has%20a%20systems%20problem.\",\"target\":\"_blank\",\"className\":\"group inline-flex items-center gap-2 border-b border-ink/30 pb-1 text-sm uppercase tracking-widest transition-colors hover:border-green hover:text-green\",\"children\":[\"Begin the diagnostic\",[\"$\",\"svg\",null,{\"width\":\"11\",\"height\":\"11\",\"viewBox\":\"0 0 12 12\",\"fill\":\"none\",\"className\":\"transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2 10L10 2M10 2H4M10 2V8\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.2\"}]}]]}]}]\n19:[\"$\",\"$L1a\",null,{\"href\":\"/journal\",\"className\":\"mt-10 inline-block text-sm text-muted transition-colors hover:text-ink\",\"children\":\"← All field reports\"}]\n12:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n15:[[\"$\",\"title\",\"0\",{\"children\":\"Your Business Should Not Need a Human Bridge Between Every System | Sonny Sayi Solutions\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"Your Business Should Not Need a Human Bridge Between Every System\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:image\",\"content\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\"}],[\"$\",\"meta\",\"5\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:title\",\"content\":\"Your Business Should Not Need a Human Bridge Between Every System\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:description\",\"content\":\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"}],[\"$\",\"meta\",\"8\",{\"name\":\"twitter:image\",\"content\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\"}]]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/1pw566iu1r5qg.css\",\"style\"]\n:HL[\"/_next/static/media/068444135650a82f-s.p.24u93d7s5mbjp.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/07c7676b89ed2778-s.p.2bn3s6zvc0dyp.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/c4d7be43e05ae6b0-s.p.2-8nwwlkvso64.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\",\"image\"]\n3:[[\"children\",{\"s\":\"__PAGE__\",\"h\":160}]]\n2:[[\"children\",{\"s\":{\"n\":\"slug\",\"t\":\"d\",\"k\":\"manual-workflow\",\"s\":[]},\"h\":96,\"c\":\"$Q3\"}]]\n1:[[\"children\",{\"s\":\"journal\",\"h\":96,\"c\":\"$Q2\"}]]\n0:{\"b\":\"c9R65ec3spqX_R0_87Nhd\",\"t\":{\"t\":{\"s\":\"\",\"h\":80,\"c\":\"$Q1\"}}}\n","/_full":"1:\"$Sreact.fragment\"\n2:\"/_next/static/chunks/3qfy96eoyh-ek.js\"\n3:\"/_next/static/chunks/1_q4oc079m3pu.js\"\n4:I[84834,[\"$2\",\"$3\"],\"default\"]\n5:I[88115,[\"$2\",\"$3\"],\"default\"]\n6:I[39756,[\"$2\",\"$3\"],\"default\"]\n7:I[37457,[\"$2\",\"$3\"],\"default\"]\nd:I[97367,[\"$2\",\"$3\"],\"OutletBoundary\"]\ne:\"$Sreact.suspense\"\n10:\"ViewportBoundary\"\n11:I[97367,[\"$2\",\"$3\"],\"$10\"]\n13:\"MetadataBoundary\"\n14:I[97367,[\"$2\",\"$3\"],\"$13\"]\n16:I[68027,[\"$2\",\"$3\"],\"default\",1]\n:HL[\"/_next/static/chunks/1pw566iu1r5qg.css\",\"style\"]\n:HL[\"/_next/static/media/068444135650a82f-s.p.24u93d7s5mbjp.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/07c7676b89ed2778-s.p.2bn3s6zvc0dyp.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/c4d7be43e05ae6b0-s.p.2-8nwwlkvso64.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n9:X\nb:[[\"children\",{\"s\":\"__PAGE__\",\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[\"$Lc\",null,[\"$\",\"$Ld\",null,{\"children\":[\"$\",\"$e\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@f\"}]}]]}],\"p\":false,\"v\":null}}]]\na:[[\"children\",{\"s\":{\"n\":\"slug\",\"t\":\"d\",\"k\":\"manual-workflow\",\"s\":[]},\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"p\":false,\"v\":\"$9\"},\"c\":\"$Qb\"}]]\n8:[[\"children\",{\"s\":\"journal\",\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"p\":false,\"v\":\"$9\"},\"c\":\"$Qa\"}]]\n0:{\"P\":null,\"c\":[\"\",\"journal\",\"manual-workflow\"],\"q\":\"\",\"i\":false,\"t\":{\"t\":{\"s\":\"\",\"h\":528,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3qfy96eoyh-ek.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_q4oc079m3pu.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"scroll-smooth\",\"children\":[\"$\",\"body\",null,{\"className\":\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\",\"children\":[[\"$\",\"$L4\",null,{}],[\"$\",\"$L5\",null,{}],[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]}]]}],\"p\":false,\"v\":null},\"c\":\"$Q8\"},\"h\":{\"r\":[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L11\",null,{\"children\":\"$L12\"}],[\"$\",\"$L14\",null,{\"children\":[[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$e\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L15\"}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],\"p\":false,\"v\":null}},\"m\":\"$undefined\",\"G\":[\"$16\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"c9R65ec3spqX_R0_87Nhd\"}\n:HL[\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\",\"image\"]\n9:C\n17:T1a18,<p>There is a strange point in the life of a growing business.</p>\n<p>The business is busy.</p>\n<p>Customers are coming in. Orders are moving. Staff are working.</p>\n<p>And yet, somehow, everyone is spending their day doing things that should have stopped requiring a person years ago.</p>\n<p>Someone copies an order from WhatsApp into Excel.</p>\n<p>Someone checks whether the payment came in.</p>\n<p>Someone sends a screenshot to another department.</p>\n<p>Someone updates the spreadsheet.</p>\n<p>Someone calls the driver.</p>\n<p>Someone asks whether the customer was contacted.</p>\n<p>Someone spends Friday afternoon making sure everyone did what the system should have tracked automatically.</p>\n<p>The business is functioning.</p>\n<p>But the workflow is being held together by people.</p>\n<h2>The WhatsApp-to-Excel pipeline</h2>\n<p>It usually starts innocently.</p>\n<p>A customer sends an order through WhatsApp.</p>\n<p>The sales person writes it down.</p>\n<p>Later, someone enters it into a spreadsheet.</p>\n<p>The warehouse receives a message.</p>\n<p>The accounts team gets another message.</p>\n<p>The customer asks for an update.</p>\n<p>Someone searches through the chat.</p>\n<p>The order is eventually delivered.</p>\n<p>Then someone has to reconcile everything.</p>\n<p>None of these steps is particularly complicated.</p>\n<p>That is exactly why they become dangerous.</p>\n<p>When a simple process happens hundreds of times, every manual handoff becomes another opportunity for something to be missed.</p>\n<p>A number gets typed incorrectly.</p>\n<p>A message gets buried.</p>\n<p>A payment is not matched.</p>\n<p>An order is duplicated.</p>\n<p>A customer waits for an update that somebody forgot to send.</p>\n<p>The problem isn't that your employees are careless.</p>\n<p><strong>The process is asking them to remember too much.</strong></p>\n<h2>When Excel becomes the database</h2>\n<p>Spreadsheets are excellent tools.</p>\n<p>They become a problem when the entire operation depends on them.</p>\n<p>One spreadsheet tracks customers.</p>\n<p>Another tracks stock.</p>\n<p>Someone has their own version.</p>\n<p>Another person keeps the \"master\" copy.</p>\n<p>Then somebody sends the latest file through WhatsApp.</p>\n<p>Six months later, nobody is completely sure which version is correct.</p>\n<p>At that point, Excel is no longer just a spreadsheet.</p>\n<p>It has become an unofficial business system.</p>\n<p>And unofficial systems are difficult to control, audit or scale.</p>\n<h2>The employee who knows everything</h2>\n<p>Every growing business eventually has one.</p>\n<p>The person everyone calls when something doesn't make sense.</p>\n<p>They know where the files are.</p>\n<p>They know which spreadsheet is current.</p>\n<p>They know which customer paid.</p>\n<p>They know which orders are waiting.</p>\n<p>They know which approval is still pending.</p>\n<p>They know the workaround.</p>\n<p>If that person is on leave, the workflow slows down.</p>\n<p>If they leave the company, part of the company's operational knowledge leaves with them.</p>\n<p>That is not an employee problem.</p>\n<p>It is a systems problem.</p>\n<p>Knowledge that matters to the business should not exist only inside someone's memory.</p>\n<h2>Automation is not about replacing people</h2>\n<p>Good automation does not begin with:</p>\n<p><strong>\"How many employees can we eliminate?\"</strong></p>\n<p>It begins with:</p>\n<p><strong>\"Why are highly capable people spending their time doing this?\"</strong></p>\n<p>If a person has to repeatedly copy information from one place to another, that is a candidate for automation.</p>\n<p>If someone has to manually calculate the same figure every day, that is a candidate for automation.</p>\n<p>If a manager has to ask three people for the status of an order, that is a workflow problem.</p>\n<p>If a customer has to wait for someone to find information that already exists in your business, the information is in the wrong place.</p>\n<p>The goal is not fewer people.</p>\n<p>The goal is fewer unnecessary steps.</p>\n<h2>What a proper workflow looks like</h2>\n<p>Imagine a customer places an order.</p>\n<p>The system records it.</p>\n<p>The relevant team is notified.</p>\n<p>Stock is checked.</p>\n<p>The order moves to fulfilment.</p>\n<p>The customer receives an update.</p>\n<p>Payment is recorded.</p>\n<p>The delivery is logged.</p>\n<p>The sale appears in the dashboard.</p>\n<p>Management can see what happened without asking five people.</p>\n<p>Nobody had to copy the same information into four different places.</p>\n<p>That is what a business system should do.</p>\n<p>It should carry information forward.</p>\n<h2>The cure</h2>\n<p>We build the system around the way your business actually operates.</p>\n<p>That can mean:</p>\n<ul>\n<li><strong>Custom dashboards</strong> that replace scattered spreadsheets.</li>\n<li><strong>Order management</strong> that takes work out of WhatsApp and into a structured workflow.</li>\n<li><strong>CRM systems</strong> that keep customer information and follow-ups in one place.</li>\n<li><strong>Inventory systems</strong> that connect stock, sales and fulfilment.</li>\n<li><strong>Approval workflows</strong> that show exactly what is waiting and who needs to act.</li>\n<li><strong>Automated reports</strong> that remove repetitive reporting work.</li>\n<li><strong>Notifications and reminders</strong> that happen because the system knows they need to happen.</li>\n<li><strong>Integrations</strong> that move information between the tools your business already uses.</li>\n</ul>\n<p>We don't automate a process simply because automation sounds impressive.</p>\n<p>First, we map the workflow.</p>\n<p>Then we find the bottlenecks.</p>\n<p>Then we decide what should be removed, what should be automated and where a person actually needs to stay involved.</p>\n<p>The result is not another piece of software your team has to fight with.</p>\n<p>It is a system that fits the way the business already works.</p>\n<hr>\n<p>Your people should be making decisions, serving customers and moving the business forward.</p>\n<p>They should not spend their day copying information between systems, hunting through WhatsApp messages or rebuilding reports that the business has already generated.</p>\n<p>If the same task happens every day, the same information is entered more than once, or the same person has to manually keep the operation connected, there is probably a better way to run it.</p>\n<p><strong>That's where we come in.</strong></p>\n<p><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20report%20on%20workflow%20and%20automation.%20We%20have%20manual%20processes%20that%20need%20to%20be%20fixed.\">Begin the diagnostic</a></p>\nc:[\"$\",\"main\",null,{\"className\":\"pt-28 md:pt-32\",\"children\":[\"$\",\"article\",null,{\"className\":\"px-6 py-16 md:px-16 md:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-green\",\"children\":\"Custom Applications\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-08-17\",\"children\":\"2026-08-17\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\",\"children\":\"Your Business Should Not Need a Human Bridge Between Every System\"}],[\"$\",\"figure\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -inset-4 bg-green/[0.06] blur-2xl\",\"aria-hidden\":\"true\"}],[\"$\",\"img\",null,{\"src\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\",\"alt\":\"Your Business Should Not Need a Human Bridge Between Every System\",\"className\":\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\"}]]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":\"Fig. 05 — The Friday-night reconciliation desk.\"}]]}],[\"$\",\"div\",null,{\"className\":\"journal-body mt-14\",\"dangerouslySetInnerHTML\":{\"__html\":\"$17\"}}],\"$L18\",\"$L19\"]}]}]}]\n1a:I[22016,[\"$2\",\"$3\"],\"\"]\n18:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-ink/10 pt-10\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20just%20read%20the%20journal.%20I%20think%20my%20business%20has%20a%20systems%20problem.\",\"target\":\"_blank\",\"className\":\"group inline-flex items-center gap-2 border-b border-ink/30 pb-1 text-sm uppercase tracking-widest transition-colors hover:border-green hover:text-green\",\"children\":[\"Begin the diagnostic\",[\"$\",\"svg\",null,{\"width\":\"11\",\"height\":\"11\",\"viewBox\":\"0 0 12 12\",\"fill\":\"none\",\"className\":\"transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2 10L10 2M10 2H4M10 2V8\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.2\"}]}]]}]}]\n19:[\"$\",\"$L1a\",null,{\"href\":\"/journal\",\"className\":\"mt-10 inline-block text-sm text-muted transition-colors hover:text-ink\",\"children\":\"← All field reports\"}]\n12:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n15:[[\"$\",\"title\",\"0\",{\"children\":\"Your Business Should Not Need a Human Bridge Between Every System | Sonny Sayi Solutions\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"Your Business Should Not Need a Human Bridge Between Every System\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:image\",\"content\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\"}],[\"$\",\"meta\",\"5\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:title\",\"content\":\"Your Business Should Not Need a Human Bridge Between Every System\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:description\",\"content\":\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"}],[\"$\",\"meta\",\"8\",{\"name\":\"twitter:image\",\"content\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\"}]]\n","/journal/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:\"/_next/static/chunks/3qfy96eoyh-ek.js\"\n3:\"/_next/static/chunks/1_q4oc079m3pu.js\"\n4:I[84834,[\"$2\",\"$3\"],\"default\"]\n5:I[88115,[\"$2\",\"$3\"],\"default\"]\n6:I[39756,[\"$2\",\"$3\"],\"default\"]\n7:I[37457,[\"$2\",\"$3\"],\"default\"]\n15:\"ViewportBoundary\"\n16:I[97367,[\"$2\",\"$3\"],\"$15\"]\n17:\"MetadataBoundary\"\n18:I[97367,[\"$2\",\"$3\"],\"$17\"]\n19:\"$Sreact.suspense\"\n:HL[\"/_next/static/chunks/1pw566iu1r5qg.css\",\"style\"]\n:HL[\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\",\"image\"]\n9:X\nc:X\nc:C\n10:T1a18,<p>There is a strange point in the life of a growing business.</p>\n<p>The business is busy.</p>\n<p>Customers are coming in. Orders are moving. Staff are working.</p>\n<p>And yet, somehow, everyone is spending their day doing things that should have stopped requiring a person years ago.</p>\n<p>Someone copies an order from WhatsApp into Excel.</p>\n<p>Someone checks whether the payment came in.</p>\n<p>Someone sends a screenshot to another department.</p>\n<p>Someone updates the spreadsheet.</p>\n<p>Someone calls the driver.</p>\n<p>Someone asks whether the customer was contacted.</p>\n<p>Someone spends Friday afternoon making sure everyone did what the system should have tracked automatically.</p>\n<p>The business is functioning.</p>\n<p>But the workflow is being held together by people.</p>\n<h2>The WhatsApp-to-Excel pipeline</h2>\n<p>It usually starts innocently.</p>\n<p>A customer sends an order through WhatsApp.</p>\n<p>The sales person writes it down.</p>\n<p>Later, someone enters it into a spreadsheet.</p>\n<p>The warehouse receives a message.</p>\n<p>The accounts team gets another message.</p>\n<p>The customer asks for an update.</p>\n<p>Someone searches through the chat.</p>\n<p>The order is eventually delivered.</p>\n<p>Then someone has to reconcile everything.</p>\n<p>None of these steps is particularly complicated.</p>\n<p>That is exactly why they become dangerous.</p>\n<p>When a simple process happens hundreds of times, every manual handoff becomes another opportunity for something to be missed.</p>\n<p>A number gets typed incorrectly.</p>\n<p>A message gets buried.</p>\n<p>A payment is not matched.</p>\n<p>An order is duplicated.</p>\n<p>A customer waits for an update that somebody forgot to send.</p>\n<p>The problem isn't that your employees are careless.</p>\n<p><strong>The process is asking them to remember too much.</strong></p>\n<h2>When Excel becomes the database</h2>\n<p>Spreadsheets are excellent tools.</p>\n<p>They become a problem when the entire operation depends on them.</p>\n<p>One spreadsheet tracks customers.</p>\n<p>Another tracks stock.</p>\n<p>Someone has their own version.</p>\n<p>Another person keeps the \"master\" copy.</p>\n<p>Then somebody sends the latest file through WhatsApp.</p>\n<p>Six months later, nobody is completely sure which version is correct.</p>\n<p>At that point, Excel is no longer just a spreadsheet.</p>\n<p>It has become an unofficial business system.</p>\n<p>And unofficial systems are difficult to control, audit or scale.</p>\n<h2>The employee who knows everything</h2>\n<p>Every growing business eventually has one.</p>\n<p>The person everyone calls when something doesn't make sense.</p>\n<p>They know where the files are.</p>\n<p>They know which spreadsheet is current.</p>\n<p>They know which customer paid.</p>\n<p>They know which orders are waiting.</p>\n<p>They know which approval is still pending.</p>\n<p>They know the workaround.</p>\n<p>If that person is on leave, the workflow slows down.</p>\n<p>If they leave the company, part of the company's operational knowledge leaves with them.</p>\n<p>That is not an employee problem.</p>\n<p>It is a systems problem.</p>\n<p>Knowledge that matters to the business should not exist only inside someone's memory.</p>\n<h2>Automation is not about replacing people</h2>\n<p>Good automation does not begin with:</p>\n<p><strong>\"How many employees can we eliminate?\"</strong></p>\n<p>It begins with:</p>\n<p><strong>\"Why are highly capable people spending their time doing this?\"</strong></p>\n<p>If a person has to repeatedly copy information from one place to another, that is a candidate for automation.</p>\n<p>If someone has to manually calculate the same figure every day, that is a candidate for automation.</p>\n<p>If a manager has to ask three people for the status of an order, that is a workflow problem.</p>\n<p>If a customer has to wait for someone to find information that already exists in your business, the information is in the wrong place.</p>\n<p>The goal is not fewer people.</p>\n<p>The goal is fewer unnecessary steps.</p>\n<h2>What a proper workflow looks like</h2>\n<p>Imagine a customer places an order.</p>\n<p>The system records it.</p>\n<p>The relevant team is notified.</p>\n<p>Stock is checked.</p>\n<p>The order moves to fulfilment.</p>\n<p>The customer receives an update.</p>\n<p>Payment is recorded.</p>\n<p>The delivery is logged.</p>\n<p>The sale appears in the dashboard.</p>\n<p>Management can see what happened without asking five people.</p>\n<p>Nobody had to copy the same information into four different places.</p>\n<p>That is what a business system should do.</p>\n<p>It should carry information forward.</p>\n<h2>The cure</h2>\n<p>We build the system around the way your business actually operates.</p>\n<p>That can mean:</p>\n<ul>\n<li><strong>Custom dashboards</strong> that replace scattered spreadsheets.</li>\n<li><strong>Order management</strong> that takes work out of WhatsApp and into a structured workflow.</li>\n<li><strong>CRM systems</strong> that keep customer information and follow-ups in one place.</li>\n<li><strong>Inventory systems</strong> that connect stock, sales and fulfilment.</li>\n<li><strong>Approval workflows</strong> that show exactly what is waiting and who needs to act.</li>\n<li><strong>Automated reports</strong> that remove repetitive reporting work.</li>\n<li><strong>Notifications and reminders</strong> that happen because the system knows they need to happen.</li>\n<li><strong>Integrations</strong> that move information between the tools your business already uses.</li>\n</ul>\n<p>We don't automate a process simply because automation sounds impressive.</p>\n<p>First, we map the workflow.</p>\n<p>Then we find the bottlenecks.</p>\n<p>Then we decide what should be removed, what should be automated and where a person actually needs to stay involved.</p>\n<p>The result is not another piece of software your team has to fight with.</p>\n<p>It is a system that fits the way the business already works.</p>\n<hr>\n<p>Your people should be making decisions, serving customers and moving the business forward.</p>\n<p>They should not spend their day copying information between systems, hunting through WhatsApp messages or rebuilding reports that the business has already generated.</p>\n<p>If the same task happens every day, the same information is entered more than once, or the same person has to manually keep the operation connected, there is probably a better way to run it.</p>\n<p><strong>That's where we come in.</strong></p>\n<p><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20report%20on%20workflow%20and%20automation.%20We%20have%20manual%20processes%20that%20need%20to%20be%20fixed.\">Begin the diagnostic</a></p>\nf:[[\"children\",{\"s\":\"__PAGE__\",\"h\":160,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"pt-28 md:pt-32\",\"children\":[\"$\",\"article\",null,{\"className\":\"px-6 py-16 md:px-16 md:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-green\",\"children\":\"Custom Applications\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-08-17\",\"children\":\"2026-08-17\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\",\"children\":\"Your Business Should Not Need a Human Bridge Between Every System\"}],[\"$\",\"figure\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -inset-4 bg-green/[0.06] blur-2xl\",\"aria-hidden\":\"true\"}],[\"$\",\"img\",null,{\"src\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\",\"alt\":\"Your Business Should Not Need a Human Bridge Between Every System\",\"className\":\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\"}]]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":\"Fig. 05 — The Friday-night reconciliation desk.\"}]]}],[\"$\",\"div\",null,{\"className\":\"journal-body mt-14\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10\"}}],\"$L11\",\"$L12\"]}]}]}],null,\"$L13\"]}],\"p\":\"$@14\",\"v\":null,\"s\":\"$9\"}}]]\nd:[[\"children\",{\"s\":{\"n\":\"slug\",\"t\":\"d\",\"k\":\"manual-workflow\",\"s\":[]},\"h\":96,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L7\",null,{}]}]]}],\"p\":\"$@e\",\"v\":\"$c\",\"s\":\"$9\"},\"c\":\"$Qf\"}]]\na:[[\"children\",{\"s\":\"journal\",\"h\":96,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L7\",null,{}]}]]}],\"p\":\"$@b\",\"v\":\"$c\",\"s\":\"$9\"},\"c\":\"$Qd\"}]]\n0:{\"t\":{\"t\":{\"s\":\"\",\"h\":80,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/ch