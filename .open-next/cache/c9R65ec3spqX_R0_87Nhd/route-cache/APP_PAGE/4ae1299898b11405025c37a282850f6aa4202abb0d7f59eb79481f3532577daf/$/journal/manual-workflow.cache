{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/journal/layout,_N_T_/journal/[slug]/layout,_N_T_/journal/[slug]/page,_N_T_/journal/manual-workflow"},"segmentPaths":["/_tree","/_full","/journal/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/4ae1299898b11405025c37a282850f6aa4202abb0d7f59eb79481f3532577daf/$/journal/manual-workflow","owner":{"kind":"APP_PAGE","sourceRoute":"/journal/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"scroll-smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/068444135650a82f-s.p.24u93d7s5mbjp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/07c7676b89ed2778-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/c4d7be43e05ae6b0-s.p.2-8nwwlkvso64.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1pw566iu1r5qg.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1pcw6gskne7pf.js\"/><script src=\"/_next/static/chunks/0vm8zo6v48m9c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-liacn1-fmrj.js\" async=\"\"></script><script src=\"/_next/static/chunks/3ncqdelv46e8a.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/3qfy96eoyh-ek.js\" async=\"\"></script><script src=\"/_next/static/chunks/1_q4oc079m3pu.js\" async=\"\"></script><title>Your Business Should Not Need a Human Bridge Between Every System | Sonny Sayi Solutions</title><meta name=\"description\" content=\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"/><meta property=\"og:title\" content=\"Your Business Should Not Need a Human Bridge Between Every System\"/><meta property=\"og:description\" content=\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"/><meta property=\"og:image\" content=\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Your Business Should Not Need a Human Bridge Between Every System\"/><meta name=\"twitter:description\" content=\"WhatsApp orders. Spreadsheets. Approval messages. Repeated data entry. Follow-up calls. When people become the connection between disconnected processes, the business starts paying for the gaps.\"/><meta name=\"twitter:image\" content=\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859643/friday-night-reconciliation-desk_b8vcz5.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent\"><div class=\"flex items-center justify-between px-6 py-5 md:px-16\"><a class=\"flex items-center gap-4\" href=\"/\"><img alt=\"Sonny Sayi Solutions\" lo