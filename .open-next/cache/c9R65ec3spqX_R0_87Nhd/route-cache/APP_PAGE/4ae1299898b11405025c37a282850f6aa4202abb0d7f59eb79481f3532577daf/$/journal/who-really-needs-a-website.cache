,\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"p\":false,\"v\":\"$9\"},\"c\":\"$Qb\"}]]\n8:[[\"children\",{\"s\":\"journal\",\"h\":512,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"p\":false,\"v\":\"$9\"},\"c\":\"$Qa\"}]]\n0:{\"P\":null,\"c\":[\"\",\"journal\",\"who-really-needs-a-website\"],\"q\":\"\",\"i\":false,\"t\":{\"t\":{\"s\":\"\",\"h\":528,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3qfy96eoyh-ek.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_q4oc079m3pu.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"scroll-smooth\",\"children\":[\"$\",\"body\",null,{\"className\":\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\",\"children\":[[\"$\",\"$L4\",null,{}],[\"$\",\"$L5\",null,{}],[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]}]]}],\"p\":false,\"v\":null},\"c\":\"$Q8\"},\"h\":{\"r\":[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L11\",null,{\"children\":\"$L12\"}],[\"$\",\"$L14\",null,{\"children\":[[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$e\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L15\"}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],\"p\":false,\"v\":null}},\"m\":\"$undefined\",\"G\":[\"$16\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"c9R65ec3spqX_R0_87Nhd\"}\n:HL[\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859644/surgical-showroom_d0gdmo.png\",\"image\"]\n9:C\n17:T1544,<p>Let us start with something most web developers will never tell you:</p>\n<p><strong>Not every business needs a website.</strong></p>\n<p>If most of your customers already know you, find you through referrals and come back because they trust you, a website may not be the thing holding your business back.</p>\n<p>But there is another kind of business.</p>\n<p>The kind where a potential customer hears your name, opens their phone, searches for you and starts checking.</p>\n<p>That search happens before the phone call.</p>\n<p>Sometimes before you even know the buyer exists.</p>\n<h2>The five-minute background check</h2>\n<p>A serious buyer rarely wants to be the first person to trust you.</p>\n<p>They check.</p>\n<p>They look for your location.<br>\nThey look at what you sell.<br>\nThey look for evidence that you have done this before.<br>\nThey compare you with someone else.</p>\n<p>For some businesses, this is where the sale begins.</p>\n<p>And if there is nothing useful to find, the buyer has to fill in the blanks themselves.</p>\n<p>That is where the problem starts.</p>\n<h2>Land &#x26; property: the buyer is checking before the site visit</h2>\n<p>A land buyer has questions before they ever get in the car.</p>\n<p>Where is the company located?</p>\n<p>What projects have they completed?</p>\n<p>What properties are available?</p>\n<p>What do the plots actually look like?</p>\n<p>Who else has bought from them?</p>\n<p>A strong digital presence cannot replace due diligence. It can, however, make that due diligence easier.</p>\n<p>Instead of sending a buyer through scattered WhatsApp photos, old Facebook posts and forwarded PDFs, you give them somewhere structured to start.</p>\n<p>Listings.<br>\nProject history.<br>\nLocation information.<br>\nPhotos.<br>\nEnquiry channels.</p>\n<p>The buyer arrives at the phone call with context instead of suspicion.</p>\n<h2>Medical equipment: your catalogue is part of the sales process</h2>\n<p>A hospital, clinic or procurement team may need to evaluate dozens of products before speaking to a supplier.</p>\n<p>They want specifications.</p>\n<p>They want product categories.</p>\n<p>They want documentation.</p>\n<p>They want to know who supplies the equipment and whether the company looks established enough to deal with.</p>\n<p>If your entire catalogue is a collection of PDFs and WhatsApp attachments, every enquiry starts with someone on your team manually sending information.</p>\n<p>A structured website changes that.</p>\n<p>The buyer can browse the catalogue, understand the products and arrive at the conversation already informed.</p>\n<p>Your sales team stops being a human search engine.</p>\n<h2>Schools: the shortlist starts before open day</h2>\n<p>Parents don't always begin with a school visit.</p>\n<p>They search.</p>\n<p>They compare.</p>\n<p>They look at the curriculum, facilities, location, admissions process and the overall picture of the institution.</p>\n<p>Then they make a shortlist.</p>\n<p>Only after that comes the visit.</p>\n<p>That means your website is doing something important before the admissions office ever gets the parent's call.</p>\n<p>It is answering the first questions.</p>\n<p>It is setting expectations.</p>\n<p>It is giving the parent enough confidence to take the next step.</p>\n<p>A school website should therefore feel less like an online poster and more like the front office of the institution.</p>\n<h2>The real job of a business website</h2>\n<p>A website should not exist because someone said:</p>\n<blockquote>\n<p>\"Every business needs a website.\"</p>\n</blockquote>\n<p>That is lazy advice.</p>\n<p>The real question is:</p>\n<p><strong>What does a potential customer need to know before they are willing to contact you?</strong></p>\n<p>If the answer includes your services, products, projects, location, credentials, process, pricing information or previous work, that information needs somewhere reliable to live.</p>\n<p>A good website becomes that place.</p>\n<p>It can be found through search.</p>\n<p>It can be shared directly.</p>\n<p>It can answer questions outside business hours.</p>\n<p>And most importantly, it gives a potential customer something concrete to evaluate.</p>\n<h2>The cure</h2>\n<p>We don't start with a template and ask you what text to put into it.</p>\n<p>We start with the buyer.</p>\n<p>For a property company, that might mean:</p>\n<ul>\n<li>Searchable property listings</li>\n<li>Project and development history</li>\n<li>Location and verification information</li>\n<li>Clear enquiry paths</li>\n</ul>\n<p>For a medical supplier:</p>\n<ul>\n<li>Structured product catalogues</li>\n<li>Technical specifications</li>\n<li>Product categories</li>\n<li>Documentation and enquiry workflows</li>\n</ul>\n<p>For a school:</p>\n<ul>\n<li>Curriculum and programmes</li>\n<li>Facilities and school life</li>\n<li>Admissions information</li>\n<li>Fees and contact pathways</li>\n</ul>\n<p>Different businesses have different evaluation processes.</p>\n<p>The website should be built around yours.</p>\n<hr>\n<p>If your customers research you before they contact you, your digital presence is already part of your sales process.</p>\n<p>The question is whether it is helping you get evaluated — or giving the buyer a reason to move on.</p>\n<p><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20report%20on%20businesses%20being%20evaluated%20online.%20I%20want%20to%20improve%20how%20my%20business%20is%20presented%20online.\">Begin the diagnostic</a></p>\nc:[\"$\",\"main\",null,{\"className\":\"pt-28 md:pt-32\",\"children\":[\"$\",\"article\",null,{\"className\":\"px-6 py-16 md:px-16 md:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-green\",\"children\":\"Web Platforms\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-08-17\",\"children\":\"2026-08-17\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\",\"children\":\"Not Every Business Needs a Website. These Three Can't Afford to Be Invisible.\"}],[\"$\",\"figure\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -inset-4 bg-green/[0.06] blur-2xl\",\"aria-hidden\":\"true\"}],[\"$\",\"img\",null,{\"src\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859644/surgical-showroom_d0gdmo.png\",\"alt\":\"Not Every Business Needs a Website. These Three Can't Afford to Be Invisible.\",\"className\":\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\"}]]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":\"Fig. 04 — The evaluation happens online, whether you are there or not.\"}]]}],[\"$\",\"div\",null,{\"className\":\"journal-body mt-14\",\"dangerouslySetInnerHTML\":{\"__html\":\"$17\"}}],\"$L18\",\"$L19\"]}]}]}]\n1a:I[22016,[\"$2\",\"$3\"],\"\"]\n18:[\"$\",\"div\",null,{\"className\":\"mt-16 border-t border-ink/10 pt-10\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20just%20read%20the%20journal.%20I%20think%20my%20business%20has%20a%20systems%20problem.\",\"target\":\"_blank\",\"className\":\"group inline-flex items-center gap-2 border-b border-ink/30 pb-1 text-sm uppercase tracking-widest transition-colors hover:border-green hover:text-green\",\"children\":[\"Begin the diagnostic\",[\"$\",\"svg\",null,{\"width\":\"11\",\"height\":\"11\",\"viewBox\":\"0 0 12 12\",\"fill\":\"none\",\"className\":\"transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1\",\"children\":[\"$\",\"path\",null,{\"d\":\"M2 10L10 2M10 2H4M10 2V8\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.2\"}]}]]}]}]\n19:[\"$\",\"$L1a\",null,{\"href\":\"/journal\",\"className\":\"mt-10 inline-block text-sm text-muted transition-colors hover:text-ink\",\"children\":\"← All field reports\"}]\n12:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n15:[[\"$\",\"title\",\"0\",{\"children\":\"Not Every Business Needs a Website. These Three Can't Afford to Be Invisible. | Sonny Sayi Solutions\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Before the call, before the site visit, before the quotation, someone is already checking you. For property companies, medical suppliers and schools, that evaluation often starts online.\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"Not Every Business Needs a Website. These Three Can't Afford to Be Invisible.\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"Before the call, before the site visit, before the quotation, someone is already checking you. For property companies, medical suppliers and schools, that evaluation often starts online.\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:image\",\"content\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859644/surgical-showroom_d0gdmo.png\"}],[\"$\",\"meta\",\"5\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:title\",\"content\":\"Not Every Business Needs a Website. These Three Can't Afford to Be Invisible.\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:description\",\"content\":\"Before the call, before the site visit, before the quotation, someone is already checking you. For property companies, medical suppliers and schools, that evaluation often starts online.\"}],[\"$\",\"meta\",\"8\",{\"name\":\"twitter:image\",\"content\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859644/surgical-showroom_d0gdmo.png\"}]]\n","/journal/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:\"/_next/static/chunks/3qfy96eoyh-ek.js\"\n3:\"/_next/static/chunks/1_q4oc079m3pu.js\"\n4:I[84834,[\"$2\",\"$3\"],\"default\"]\n5:I[88115,[\"$2\",\"$3\"],\"default\"]\n6:I[39756,[\"$2\",\"$3\"],\"default\"]\n7:I[37457,[\"$2\",\"$3\"],\"default\"]\n15:\"ViewportBoundary\"\n16:I[97367,[\"$2\",\"$3\"],\"$15\"]\n17:\"MetadataBoundary\"\n18:I[97367,[\"$2\",\"$3\"],\"$17\"]\n19:\"$Sreact.suspense\"\n:HL[\"/_next/static/chunks/1pw566iu1r5qg.css\",\"style\"]\n:HL[\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859644/surgical-showroom_d0gdmo.png\",\"image\"]\n9:X\nc:X\nc:C\n10:T1544,<p>Let us start with something most web developers will never tell you:</p>\n<p><strong>Not every business needs a website.</strong></p>\n<p>If most of your customers already know you, find you through referrals and come back because they trust you, a website may not be the thing holding your business back.</p>\n<p>But there is another kind of business.</p>\n<p>The kind where a potential customer hears your name, opens their phone, searches for you and starts checking.</p>\n<p>That search happens before the phone call.</p>\n<p>Sometimes before you even know the buyer exists.</p>\n<h2>The five-minute background check</h2>\n<p>A serious buyer rarely wants to be the first person to trust you.</p>\n<p>They check.</p>\n<p>They look for your location.<br>\nThey look at what you sell.<br>\nThey look for evidence that you have done this before.<br>\nThey compare you with someone else.</p>\n<p>For some businesses, this is where the sale begins.</p>\n<p>And if there is nothing useful to find, the buyer has to fill in the blanks themselves.</p>\n<p>That is where the problem starts.</p>\n<h2>Land &#x26; property: the buyer is checking before the site visit</h2>\n<p>A land buyer has questions before they ever get in the car.</p>\n<p>Where is the company located?</p>\n<p>What projects have they completed?</p>\n<p>What properties are available?</p>\n<p>What do the plots actually look like?</p>\n<p>Who else has bought from them?</p>\n<p>A strong digital presence cannot replace due diligence. It can, however, make that due diligence easier.</p>\n<p>Instead of sending a buyer through scattered WhatsApp photos, old Facebook posts and forwarded PDFs, you give them somewhere structured to start.</p>\n<p>Listings.<br>\nProject history.<br>\nLocation information.<br>\nPhotos.<br>\nEnquiry channels.</p>\n<p>The buyer arrives at the phone call with context instead of suspicion.</p>\n<h2>Medical equipment: your catalogue is part of the sales process</h2>\n<p>A hospital, clinic or procurement team may need to evaluate dozens of products before speaking to a supplier.</p>\n<p>They want specifications.</p>\n<p>They want product categories.</p>\n<p>They want documentation.</p>\n<p>They want to know who supplies the equipment and whether the company looks established enough to deal with.</p>\n<p>If your entire catalogue is a collection of PDFs and WhatsApp attachments, every enquiry starts with someone on your team manually sending information.</p>\n<p>A structured website changes that.</p>\n<p>The buyer can browse the catalogue, understand the products and arrive at the conversation already informed.</p>\n<p>Your sales team stops being a human search engine.</p>\n<h2>Schools: the shortlist starts before open day</h2>\n<p>Parents don't always begin with a school visit.</p>\n<p>They search.</p>\n<p>They compare.</p>\n<p>They look at the curriculum, facilities, location, admissions process and the overall picture of the institution.</p>\n<p>Then they make a shortlist.</p>\n<p>Only after that comes the visit.</p>\n<p>That means your website is doing something important before the admissions office ever gets the parent's call.</p>\n<p>It is answering the first questions.</p>\n<p>It is setting expectations.</p>\n<p>It is giving the parent enough confidence to take the next step.</p>\n<p>A school website should therefore feel less like an online poster and more like the front office of the institution.</p>\n<h2>The real job of a business website</h2>\n<p>A website should not exist because someone said:</p>\n<blockquote>\n<p>\"Every business needs a website.\"</p>\n</blockquote>\n<p>That is lazy advice.</p>\n<p>The real question is:</p>\n<p><strong>What does a potential customer need to know before they are willing to contact you?</strong></p>\n<p>If the answer includes your services, products, projects, location, credentials, process, pricing information or previous work, that information needs somewhere reliable to live.</p>\n<p>A good website becomes that place.</p>\n<p>It can be found through search.</p>\n<p>It can be shared directly.</p>\n<p>It can answer questions outside business hours.</p>\n<p>And most importantly, it gives a potential customer something concrete to evaluate.</p>\n<h2>The cure</h2>\n<p>We don't start with a template and ask you what text to put into it.</p>\n<p>We start with the buyer.</p>\n<p>For a property company, that might mean:</p>\n<ul>\n<li>Searchable property listings</li>\n<li>Project and development history</li>\n<li>Location and verification information</li>\n<li>Clear enquiry paths</li>\n</ul>\n<p>For a medical supplier:</p>\n<ul>\n<li>Structured product catalogues</li>\n<li>Technical specifications</li>\n<li>Product categories</li>\n<li>Documentation and enquiry workflows</li>\n</ul>\n<p>For a school:</p>\n<ul>\n<li>Curriculum and programmes</li>\n<li>Facilities and school life</li>\n<li>Admissions information</li>\n<li>Fees and contact pathways</li>\n</ul>\n<p>Different businesses have different evaluation processes.</p>\n<p>The website should be built around yours.</p>\n<hr>\n<p>If your customers research you before they contact you, your digital presence is already part of your sales process.</p>\n<p>The question is whether it is helping you get evaluated — or giving the buyer a reason to move on.</p>\n<p><a href=\"https://wa.me/254736194051?text=Hi%20Sonny,%20I%20read%20the%20report%20on%20businesses%20being%20evaluated%20online.%20I%20want%20to%20improve%20how%20my%20business%20is%20presented%20online.\">Begin the diagnostic</a></p>\nf:[[\"children\",{\"s\":\"__PAGE__\",\"h\":160,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"pt-28 md:pt-32\",\"children\":[\"$\",\"article\",null,{\"className\":\"px-6 py-16 md:px-16 md:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-baseline justify-between font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-green\",\"children\":\"Web Platforms\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-08-17\",\"children\":\"2026-08-17\"}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 font-serif font-semibold leading-[1.1] text-[clamp(2rem,5vw,3.75rem)]\",\"children\":\"Not Every Business Needs a Website. These Three Can't Afford to Be Invisible.\"}],[\"$\",\"figure\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -inset-4 bg-green/[0.06] blur-2xl\",\"aria-hidden\":\"true\"}],[\"$\",\"img\",null,{\"src\":\"https://res.cloudinary.com/dzyxm0rhg/image/upload/f_auto,q_auto/v1786859644/surgical-showroom_d0gdmo.png\",\"alt\":\"Not Every Business Needs a Website. These Three Can't Afford to Be Invisible.\",\"className\":\"relative w-full max-w-sm border border-ink/20 shadow-[0_24px_70px_rgba(0,0,0,0.55)]\"}]]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-muted\",\"children\":\"Fig. 04 — The evaluation happens online, whether you are there or not.\"}]]}],[\"$\",\"div\",null,{\"className\":\"journal-body mt-14\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10\"}}],\"$L11\",\"$L12\"]}]}]}],null,\"$L13\"]}],\"p\":\"$@14\",\"v\":null,\"s\":\"$9\"}}]]\nd:[[\"children\",{\"s\":{\"n\":\"slug\",\"t\":\"d\",\"k\":\"who-really-needs-a-website\",\"s\":[]},\"h\":96,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L7\",null,{}]}]]}],\"p\":\"$@e\",\"v\":\"$c\",\"s\":\"$9\"},\"c\":\"$Qf\"}]]\na:[[\"children\",{\"s\":\"journal\",\"h\":96,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L7\",null,{}]}]]}],\"p\":\"$@b\",\"v\":\"$c\",\"s\":\"$9\"},\"c\":\"$Qd\"}]]\n0:{\"t\":{\"t\":{\"s\":\"\",\"h\":80,\"d\":{\"r\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1pw566iu1r5qg.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3qfy96eoyh-ek.js\",\"async\":true}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1_q4oc079m3pu.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"scroll-smooth\",\"children\":[\"$\",\"body\",null,{\"className\":\"TGIECW_variable _9mH_6q_variable font-sans bg-deep text-ink antialiased\",\"children\":[[\"$\",\"$L4\",null,{}],[\"$\",\"$L5\",null,{}],[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L7\",null,{}],\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\